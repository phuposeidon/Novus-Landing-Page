---
interface Props {
  title?: string;
  description?: string;
  ogType?: string;
  ogImagePath?: string;
  includeAppSchema?: boolean;
  extraJsonLd?: Record<string, unknown> | Record<string, unknown>[];
  rssAlternate?: boolean;
}

import Analytics from "../components/Analytics.astro";
import WebMcp from "../components/WebMcp.astro";
import { QUIZSIGNAL, SHOPIFY_INSTALL_URL, SUPPORT_EMAIL } from "../config/site.ts";
import "../styles/global.css";

const {
  title = "Nexis CRO — AI Search & Conversion Suite for Shopify",
  description = "Audit and rank in ChatGPT, Perplexity & Google AI with AI SEO & AEO Audit, and boost storefront conversions with Quiz Signal product recommendation funnels.",
  ogType = "website",
  ogImagePath = "/og-image.png",
  includeAppSchema = true,
  extraJsonLd,
  rssAlternate = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(ogImagePath, Astro.site);
const siteUrl = Astro.site?.href ?? "https://nexiscro.com";

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Nexis CRO",
  url: siteUrl,
  logo: new URL("/brand-mark.png", Astro.site).href,
  description:
    "AI SEO, AEO audit, and storefront conversion apps for Shopify merchants. Schema blocks, llms.txt, AI Rank Tracker, and Quiz Signal recommendation funnels.",
  sameAs: [SHOPIFY_INSTALL_URL, QUIZSIGNAL.installUrl],
  contactPoint: {
    "@type": "ContactPoint",
    email: SUPPORT_EMAIL,
    contactType: "customer support",
    availableLanguage: "English",
  },
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Nexis CRO",
  url: siteUrl,
  description,
  publisher: { "@type": "Organization", name: "Nexis CRO" },
};

const baseJsonLd = [organizationSchema, websiteSchema];
const extraBlocks = extraJsonLd
  ? Array.isArray(extraJsonLd)
    ? extraJsonLd
    : [extraJsonLd]
  : [];
const jsonLdBlocks = [...baseJsonLd, ...extraBlocks].filter(Boolean);

const interFontUrl =
  "https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap";
const monoFontUrl =
  "https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap";

---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Theme Initialization (Zero-FOUC) — Default: Light Mode -->
    <script is:inline>
      (function() {
        try {
          var saved = localStorage.getItem("theme");
          var theme = saved || "light";
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {}
      })();
    </script>

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    {rssAlternate && (
      <link
        rel="alternate"
        type="application/rss+xml"
        title="Nexis CRO Blog"
        href={new URL("/blog/rss.xml", Astro.site)}
      />
    )}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {ogImagePath.endsWith(".png") && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/png" />
      </>
    )}
    <meta property="og:site_name" content="Nexis CRO" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts: non-blocking — system stack paints LCP immediately, Inter swaps in -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={interFontUrl} />
    <link rel="stylesheet" href={interFontUrl} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={interFontUrl} /></noscript>

    <!-- Analytics DNS (script loads deferred at end of body) -->
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

    {includeAppSchema && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Nexis CRO",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Shopify",
      "url": siteUrl,
      "installUrl": SHOPIFY_INSTALL_URL,
      "description": description,
      "offers": [
        {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD",
          "name": "Free"
        },
        {
          "@type": "Offer",
          "price": "29",
          "priceCurrency": "USD",
          "name": "Pro"
        },
        {
          "@type": "Offer",
          "price": "59",
          "priceCurrency": "USD",
          "name": "Growth"
        },
        {
          "@type": "Offer",
          "price": "149",
          "priceCurrency": "USD",
          "name": "Agency"
        }
      ]
    })} />
    )}

    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
    <!-- GSAP for Smooth Kinetic Animations -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" is:inline></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" is:inline></script>
  </head>


  <body>
    <div class="site-frame">
      <slot />
    </div>

    <!-- Mono font — below the fold, load async -->
    <link rel="stylesheet" href={monoFontUrl} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={monoFontUrl} /></noscript>

    <Analytics />

    <WebMcp />

    <!-- Scroll-triggered animations -->
    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        const animated = document.querySelectorAll(".animate-on-scroll");

        // Reveal anything already in the viewport immediately (no IO wait)
        animated.forEach((el) => {
          const rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight * 0.92) {
            el.classList.add("visible");
          }
        });

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("visible");
              }
            });
          },
          { threshold: 0.08, rootMargin: "0px 0px -24px 0px" }
        );
        animated.forEach((el) => {
          if (!el.classList.contains("visible")) observer.observe(el);
        });
      });
    </script>
  </body>
</html>
