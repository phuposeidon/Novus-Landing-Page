---
import Layout from "./Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { EDITORIAL_AUTHOR } from "../config/site.ts";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  tags?: string[];
  heroImage?: string;
  heroImageAlt?: string;
  faqSchema?: { question: string; answer: string }[];
  slug: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  author,
  tags = [],
  heroImage,
  heroImageAlt,
  faqSchema = [],
  slug,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const postUrl = new URL(`/blog/${slug}/`, Astro.site);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: new URL("/", Astro.site).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Blog",
      item: new URL("/blog/", Astro.site).href,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: title,
      item: postUrl.href,
    },
  ],
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  author: {
    "@type": "Person",
    name: author,
    url: new URL(EDITORIAL_AUTHOR.path, Astro.site).href,
    jobTitle: EDITORIAL_AUTHOR.jobTitle,
    worksFor: { "@type": "Organization", name: "Nexis CRO", url: new URL("/", Astro.site).href },
  },
  publisher: {
    "@type": "Organization",
    name: "Nexis CRO",
    logo: { "@type": "ImageObject", url: new URL("/brand-mark.svg", Astro.site).href },
  },
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalURL.href },
  image: new URL(heroImage ?? "/og-image.png", Astro.site).href,
  keywords: tags.join(", "),
};

const faqPageSchema =
  faqSchema.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqSchema.map((item) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: { "@type": "Answer", text: item.answer },
        })),
      }
    : null;

const extraJsonLd = faqPageSchema
  ? [articleSchema, breadcrumbSchema, faqPageSchema]
  : [articleSchema, breadcrumbSchema];
---

<Layout
  title={`${title} | Nexis CRO Blog`}
  description={description}
  ogType="article"
  ogImagePath={heroImage ?? "/og-image.png"}
  includeAppSchema={false}
  extraJsonLd={extraJsonLd}
  rssAlternate={true}
>
  <Nav />

  <main class="blog-main">
    <article class="blog-article container">
      <header class="blog-header">
        <nav class="blog-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/blog">Blog</a>
          <span aria-hidden="true">/</span>
          <span class="blog-breadcrumb-current">{title}</span>
        </nav>
        <p class="overline">Nexis CRO Blog</p>
        <h1 class="display text-balance">{title}</h1>
        <p class="body-lg blog-dek">{description}</p>
        <div class="blog-meta">
          <time datetime={pubDate.toISOString()}>
            {pubDate.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </time>
          <span aria-hidden="true">·</span>
          <a href={EDITORIAL_AUTHOR.path} class="blog-author">{author}</a>
        </div>
        {heroImage && (
          <figure class="blog-hero">
            <img
              src={heroImage}
              alt={heroImageAlt ?? title}
              width="1200"
              height="630"
              loading="eager"
              decoding="async"
            />
          </figure>
        )}
      </header>

      <div class="blog-prose">
        <slot />
      </div>
    </article>
  </main>

  <Footer />

  <script is:inline define:vars={{ articleTitle: title, articleSlug: slug }}>
    document.addEventListener("DOMContentLoaded", function () {
      if (typeof window.nexisTrack === "function") {
        window.nexisTrack("blog_article_view", {
          article_title: articleTitle,
          article_slug: articleSlug,
        });
      }
    });
  </script>
</Layout>

<style>
  .blog-main {
    flex: 1;
    padding-top: calc(var(--nav-height, 72px) + var(--space-8));
    padding-bottom: var(--space-9);
  }

  .blog-article {
    max-width: 720px;
  }

  .blog-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-bottom: var(--space-4);
  }

  .blog-breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .blog-breadcrumb a:hover {
    color: var(--accent);
  }

  .blog-breadcrumb-current {
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
    max-width: 28ch;
  }

  .blog-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  .blog-dek {
    color: var(--text-secondary);
    margin: 0;
  }

  .blog-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .blog-author {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .blog-author:hover {
    color: var(--accent);
  }

  .blog-hero {
    margin: var(--space-6) 0 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
  }

  .blog-hero img {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
