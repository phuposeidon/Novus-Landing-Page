---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { QUIZSIGNAL, BLOG_URL } from "../../config/site";

const title = `Guides — ${QUIZSIGNAL.name}`;
const description =
  "Setup and CRO guides for Nexis CRO: Quiz Signal — theme blocks, recommendation rules, and quiz funnels on Shopify.";

const guides = [
  {
    title: "Product Recommendation Quiz Implementation Guide",
    summary:
      "Step-by-step guide to building storefront recommendation quizzes that map catalog products, boost conversion, and capture zero-party data.",
    status: "Live Guide",
    href: "/blog/shopify-product-recommendation-quiz/",
  },
  {
    title: "Capture Emails & Sync Quiz Data to Klaviyo",
    summary:
      "Turn on email capture in quiz results, sync customer preferences to Klaviyo, and trigger high-converting personalized post-quiz email flows.",
    status: "Live Guide",
    href: "/blog/shopify-quiz-email-personalization/",
  },
  {
    title: "How Recommendation Quizzes Cut Returns by 28%",
    summary:
      "Help shoppers find their exact right-fit product before ordering, eliminating return friction and buyer remorse.",
    status: "Live Guide",
    href: "/blog/shopify-product-quiz-reduce-returns/",
  },
  {
    title: "Build a High-Converting Shopify Gift Finder Quiz",
    summary:
      "Guide holiday and seasonal shoppers through interactive question paths to find the perfect gifts from your catalog.",
    status: "Live Guide",
    href: "/blog/shopify-gift-finder-quiz/",
  },
  {
    title: "Nexis CRO Blog (AEO & Shopify)",
    summary:
      "Answer Engine Optimization, AI search citations, and storefront conversion playbooks from the Nexis CRO editorial team.",
    status: "All Articles",
    href: BLOG_URL,
  },
] as const;

const breadcrumbsSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: Astro.site?.href ?? "https://nexiscro.com/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Quiz Signal",
      item: Astro.site ? new URL(QUIZSIGNAL.hub, Astro.site).href : "https://nexiscro.com/quizsignal/",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "Guides",
      item: Astro.site ? new URL(QUIZSIGNAL.guides, Astro.site).href : "https://nexiscro.com/quizsignal/guides/",
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  includeAppSchema={false}
  extraJsonLd={breadcrumbsSchema}
>
  <Nav />
  <main class="qs-guides-page">
    <div class="container qs-guides-shell">
      <header class="qs-guides-header">
        <p class="overline">{QUIZSIGNAL.shortName}</p>
        <h1 class="display text-balance">Guides</h1>
        <p class="body-lg qs-guides-lead">
          Practical setup notes for merchants. Dedicated Quiz Signal articles will land here and on
          the <a href={BLOG_URL}>blog</a>. Meanwhile see the{" "}
          <a href={QUIZSIGNAL.faq}>FAQ</a> and{" "}
          <a href={QUIZSIGNAL.hub}>product hub</a>.
        </p>
      </header>

      <ul class="guide-list">
        {
          guides.map((guide) => (
            <li class="guide-card">
              <div class="guide-card-top">
                <h2 class="heading-2">{guide.title}</h2>
                <span class="guide-status">{guide.status}</span>
              </div>
              <p class="body-md">{guide.summary}</p>
              {guide.href ? (
                <a class="guide-link" href={guide.href}>
                  Open →
                </a>
              ) : (
                <span class="guide-link muted">In progress</span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .qs-guides-page {
    padding: calc(var(--space-8) + 72px) 0 var(--space-9);
  }

  .qs-guides-shell {
    max-width: 720px;
  }

  .qs-guides-header {
    margin-bottom: var(--space-7);
  }

  .qs-guides-lead {
    margin: var(--space-4) 0 0;
    color: var(--text-secondary);
  }

  .qs-guides-lead a {
    color: var(--accent);
  }

  .guide-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .guide-card {
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg-deep);
  }

  .guide-card-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .guide-card h2 {
    margin: 0;
    font-size: 1.15rem;
  }

  .guide-status {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .guide-card p {
    margin: 0 0 var(--space-4);
    color: var(--text-secondary);
  }

  .guide-link {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }

  .guide-link.muted {
    color: var(--text-muted);
    font-weight: 500;
  }
</style>
