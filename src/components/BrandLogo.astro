---
interface Props {
  /** Icon width/height in px */
  size?: number;
  /** Show "Nexis CRO" wordmark beside the mark */
  showWordmark?: boolean;
  /** Nav/footer wordmark size */
  wordmarkClass?: string;
  class?: string;
}

const {
  size = 32,
  showWordmark = false,
  wordmarkClass = "",
  class: className = "",
} = Astro.props;
---

<!--
  Nexis CRO brand mark — high-contrast for dark UI (nexiscro.com)
-->
<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class:list={["brand-mark", className]}
  aria-hidden={showWordmark ? "true" : undefined}
  role={showWordmark ? undefined : "img"}
  aria-label={showWordmark ? undefined : "Nexis CRO"}
>
  <!-- Filled badge — lifts mark off pure black -->
  <circle cx="16" cy="16" r="15" fill="rgba(54, 244, 164, 0.14)" />
  <circle cx="16" cy="16" r="15" stroke="#36F4A4" stroke-opacity="0.55" stroke-width="1.5" />

  <!-- Bold N monogram -->
  <path
    d="M9.5 22.5V9.5L22.5 22.5V9.5"
    stroke="#36F4A4"
    stroke-width="3.4"
    stroke-linecap="round"
    stroke-linejoin="round"
  />

  <!-- CRO growth corner — brighter accent-soft -->
  <path
    d="M22.5 9.5H28.5M28.5 9.5V15.5"
    stroke="#c1fbd4"
    stroke-width="3.4"
    stroke-linecap="round"
    stroke-linejoin="round"
  />

  <!-- Nexus highlight -->
  <circle cx="16" cy="16" r="2" fill="#FFFFFF" />
  <circle cx="16" cy="16" r="2" fill="#36F4A4" fill-opacity="0.35" />
</svg>

{showWordmark && (
  <span class:list={["brand-wordmark", wordmarkClass]}>
    <span class="brand-name">Nexis</span><span class="brand-cro"> CRO</span>
  </span>
)}

<style>
  .brand-mark {
    display: block;
    flex-shrink: 0;
    filter: drop-shadow(0 0 10px rgba(54, 244, 164, 0.42));
  }

  .brand-wordmark {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.035em;
    color: var(--text-primary, #f7f8f8);
    line-height: 1;
    white-space: nowrap;
    text-shadow: 0 0 24px rgba(54, 244, 164, 0.12);
  }

  .brand-name {
    color: inherit;
  }

  .brand-cro {
    color: var(--accent, #36f4a4);
    font-weight: 700;
    letter-spacing: -0.015em;
    text-shadow: 0 0 16px rgba(54, 244, 164, 0.35);
  }
</style>
