---
import {
  footerLegalLinks,
  footerProductLinks,
  footerSupportLinks,
} from "../config/site.ts";
import BrandLogo from "./BrandLogo.astro";
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label="Nexis CRO home">
        <BrandLogo size={28} showWordmark wordmarkClass="footer-wordmark" />
      </a>
      <p class="footer-tagline">AI SEO & AEO Audit for Shopify</p>
    </div>

    <nav class="footer-links" aria-label="Footer navigation">
      <div class="footer-col">
        <p class="footer-col-title">Product</p>
        {footerProductLinks.map((link) => (
          <a
            href={link.href}
            {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            data-analytics-event={link.external ? "install_click" : "nav_anchor_click"}
            data-analytics-location="footer"
            {...(!link.external ? { "data-analytics-section": link.href.replace(/^\/?#/, "") } : {})}
            data-analytics-label={link.label}
          >
            {link.label}
          </a>
        ))}
      </div>
      <div class="footer-col">
        <p class="footer-col-title">Support</p>
        {footerSupportLinks.map((link) => (
          <a
            href={link.href}
            {...(link.external ? { rel: "noopener noreferrer" } : {})}
            data-analytics-event={link.external ? "contact_email_click" : "nav_anchor_click"}
            data-analytics-location="footer"
            {...(!link.external ? { "data-analytics-section": "contact" } : {})}
            data-analytics-label={link.label}
          >
            {link.label}
          </a>
        ))}
      </div>
      <div class="footer-col">
        <p class="footer-col-title">Legal</p>
        {footerLegalLinks.map((link) => (
          <a
            href={link.href}
            data-analytics-event="nav_anchor_click"
            data-analytics-location="footer"
            data-analytics-label={link.label}
          >
            {link.label}
          </a>
        ))}
      </div>
    </nav>
  </div>

  <div class="container footer-bottom">
    <span>© 2026 Nexis CRO. All rights reserved.</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding: var(--space-8) 0 var(--space-6);
    background: var(--bg-deep);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-8);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .footer-logo :global(.footer-wordmark) {
    font-size: 17px;
  }

  .footer-tagline {
    font-size: 14px;
    color: var(--text-muted);
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-col-title {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    margin-bottom: var(--space-1);
  }

  .footer-col a {
    font-size: 14px;
    color: var(--text-muted);
    transition: color var(--duration-fast);
  }

  .footer-col a:hover {
    color: var(--text-primary);
  }

  .footer-bottom {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
    font-size: 13px;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .footer-links {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .footer-links {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
</style>
