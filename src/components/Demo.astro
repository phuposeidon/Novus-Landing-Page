---
---

<section class="demo section" id="demo">
  <div class="container">
    <div class="demo-header text-center">
      <span class="overline animate-on-scroll">Live Demo</span>
      <h2 class="display animate-on-scroll text-balance">
        See What a Shopify AI SEO Audit Looks Like
      </h2>
      <p class="body-lg animate-on-scroll" style="max-width: 48ch; margin: 0 auto;">
        This is what Nexis CRO finds in the first 60 seconds. Most stores
        have issues they never knew about.
      </p>
    </div>

    <div class="demo-grid">
      <!-- Left: Interactive Live Terminal Audit Scan -->
      <div class="demo-card demo-terminal-card animate-on-scroll">
        <div class="demo-terminal-bar">
          <div class="demo-dot" style="background: #ef4444;" aria-hidden="true"></div>
          <div class="demo-dot" style="background: #f59e0b;" aria-hidden="true"></div>
          <div class="demo-dot" style="background: var(--accent);" aria-hidden="true"></div>
          <span class="mono demo-terminal-title">nexis audit — running…</span>
        </div>

        <div class="demo-scan" id="demo-scan">
          <div class="demo-scan-line" data-delay="0">
            <span class="demo-check">✓</span>
            <span class="demo-label">Checking homepage schema…</span>
            <span class="demo-result found">Organization, WebSite — found</span>
          </div>
          <div class="demo-scan-line" data-delay="300">
            <span class="demo-check">✓</span>
            <span class="demo-label">Scanning product pages…</span>
            <span class="demo-result found">Product, Offer — found</span>
          </div>
          <div class="demo-scan-line" data-delay="600">
            <span class="demo-check warning-icon">!</span>
            <span class="demo-label">Checking meta descriptions…</span>
            <span class="demo-result missing">3 products missing meta</span>
          </div>
          <div class="demo-scan-line" data-delay="900">
            <span class="demo-check critical-icon">✕</span>
            <span class="demo-label">Scanning policies…</span>
            <span class="demo-result critical">Refund policy missing</span>
          </div>
          <div class="demo-scan-line" data-delay="1200">
            <span class="demo-check">✓</span>
            <span class="demo-label">Checking llms.txt…</span>
            <span class="demo-result found">Found — auto-update on</span>
          </div>
          <div class="demo-scan-line" data-delay="1500">
            <span class="demo-check">✓</span>
            <span class="demo-label">Evaluating image alt text…</span>
            <span class="demo-result warning-text">12 missing alt text</span>
          </div>
          <div class="demo-scan-line" data-delay="1800">
            <span class="demo-check">✓</span>
            <span class="demo-label">Running AI visibility scan…</span>
            <span class="demo-result found">4 platforms scored (65/100)</span>
          </div>
        </div>

        <div class="demo-summary">
          <div class="demo-stat">
            <span class="demo-stat-num mono">8</span>
            <span class="demo-stat-label">Issues found</span>
          </div>
          <div class="demo-stat">
            <span class="demo-stat-num mono" style="color: #ef4444;">1</span>
            <span class="demo-stat-label">Critical</span>
          </div>
          <div class="demo-stat">
            <span class="demo-stat-num mono" style="color: #f59e0b;">4</span>
            <span class="demo-stat-label">High</span>
          </div>
          <div class="demo-stat">
            <span class="demo-stat-num mono">3</span>
            <span class="demo-stat-label">Medium</span>
          </div>
        </div>
      </div>

      <!-- Right: 3D Fix & Schema Showcase -->
      <div class="demo-showcase-card animate-on-scroll">
        <div class="showcase-header-bar">
          <div class="showcase-badge-pill">
            <span class="live-dot-pulse"></span>
            <span>Automated AI Resolution</span>
          </div>
          <span class="showcase-highlight">Before: 24% → After: 98%</span>
        </div>

        <div class="demo-visual-frame">
          <img
            src="/assets/demo_aeo_fixes.jpg"
            alt="1-Click AI SEO Fixes and Schema Generation for Shopify"
            width="600"
            height="338"
            loading="lazy"
            class="demo-3d-img"
          />
        </div>

        <div class="showcase-features-list">
          <div class="showcase-feat-item">
            <span class="feat-check">✓</span>
            <span>Auto-injects Google &amp; Gemini JSON-LD schema</span>
          </div>
          <div class="showcase-feat-item">
            <span class="feat-check">✓</span>
            <span>Optimizes meta titles and LLM-friendly descriptions</span>
          </div>
          <div class="showcase-feat-item">
            <span class="feat-check">✓</span>
            <span>1-Click bulk deployment across active catalog</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>



<script is:inline>
  // Animate scan lines sequentially on scroll
  const demoScan = document.getElementById("demo-scan");
  let demoAnimated = false;

  const animateDemo = () => {
    if (demoAnimated) return;
    demoAnimated = true;

    demoScan.querySelectorAll(".demo-scan-line").forEach((line) => {
      const delay = parseInt(line.dataset.delay, 10);
      setTimeout(() => line.classList.add("revealed"), delay);
    });
  };

  const demoObs = new IntersectionObserver(
    (entries) => { if (entries[0].isIntersecting) animateDemo(); },
    { threshold: 0.3 }
  );
  if (demoScan) demoObs.observe(demoScan);
</script>

<style>
  .demo-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .demo-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    max-width: 1100px;
    margin: 0 auto;
    align-items: stretch;
  }

  .demo-card {
    background: var(--bg-deep);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-elevated);
    display: flex;
    flex-direction: column;
  }

  .demo-terminal-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 18px;
    background: var(--bg-section);
    border-bottom: 1px solid var(--border);
  }

  .demo-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .demo-terminal-title {
    font-size: 11px;
    color: var(--text-muted);
    margin-left: 12px;
  }

  .demo-scan {
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    flex: 1;
  }

  .demo-scan-line {
    display: flex;
    align-items: baseline;
    gap: 10px;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s var(--ease-out), transform 0.3s var(--ease-out);
    padding: 3px 0;
  }

  .demo-scan-line.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  .demo-check {
    flex-shrink: 0;
    color: var(--accent);
    font-weight: 600;
  }

  .demo-check.warning-icon {
    color: #f59e0b;
  }

  .demo-check.critical-icon {
    color: #ef4444;
  }

  .demo-label {
    color: var(--text-muted);
    white-space: nowrap;
  }

  .demo-result {
    margin-left: auto;
    text-align: right;
  }

  .demo-result.found {
    color: var(--text-secondary);
  }

  .demo-result.missing,
  .demo-result.warning-text {
    color: #f59e0b;
  }

  .demo-result.critical {
    color: #ef4444;
  }

  .demo-summary {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--border);
    background: var(--bg-section);
  }

  .demo-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 14px 10px;
  }

  .demo-stat:not(:last-child) {
    border-right: 1px solid var(--border);
  }

  .demo-stat-num {
    font-size: 22px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .demo-stat-label {
    font-size: 10px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Right Showcase Card */
  .demo-showcase-card {
    background: var(--bg-deep);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-elevated);
    display: flex;
    flex-direction: column;
    padding: 20px;
    gap: 16px;
    justify-content: space-between;
  }

  .showcase-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }

  .showcase-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: var(--accent-dim);
    color: var(--accent);
    border: 1px solid rgba(5, 150, 105, 0.25);
  }

  .live-dot-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 6px var(--accent);
  }

  .showcase-highlight {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .demo-visual-frame {
    position: relative;
    width: 100%;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border);
    background: #020a0c;
  }

  .demo-3d-img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .demo-visual-frame:hover .demo-3d-img {
    transform: scale(1.02);
  }

  .showcase-features-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 4px 0;
  }

  .showcase-feat-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--text-secondary);
  }

  .feat-check {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--accent-dim);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: bold;
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .demo-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  @media (max-width: 640px) {
    .demo-scan {
      padding: 16px;
      font-size: 11px;
    }

    .demo-result {
      display: none;
    }

    .demo-stat-num {
      font-size: 18px;
    }
  }

</style>
