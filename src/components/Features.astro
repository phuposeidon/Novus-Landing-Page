---
const features = [
  {
    title: "AI Quick Fix",
    description: "One-click fixes for meta descriptions, product content, and policy pages. Choose from 3 tones — professional, friendly, or concise.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
  },
  {
    title: "Schema Blocks",
    description: "Automatic JSON-LD injection for 8 page types — Organization, Product, Collection, Blog, FAQ, and more. Enable once in Theme Editor.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 18l2-2-2-2"/><path d="M8 18l-2-2 2-2"/><path d="M12 2v20"/><rect x="3" y="6" width="18" height="12" rx="2"/></svg>`,
  },
  {
    title: "AI Context File",
    description: "Deploy and auto-update your llms.txt — the file AI engines read to understand your store. No code changes needed.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>`,
  },
  {
    title: "AI Visibility Scanner",
    description: "Platform-specific score cards for ChatGPT, Perplexity, Google AI, and Bing Copilot. See exactly how each engine evaluates your store.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>`,
  },
  {
    title: "Competitor Benchmarking",
    description: "Compare your AEO score against up to 5 competitor stores. Know exactly where you stand and what to prioritize.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>`,
  },
  {
    title: "Scheduled Audits",
    description: "Set it and forget it. Automatic weekly or monthly re-scans with email alerts when new issues appear or scores drop.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
  },
];
---

<section class="features section" id="features">
  <div class="container">
    <div class="features-header text-center">
      <span class="overline animate-on-scroll">Features</span>
      <h2 class="display animate-on-scroll text-balance">
        Everything you need to rank in AI search
      </h2>
    </div>

    <div class="features-grid stagger">
      {features.map((f) => (
        <div class="feature-card card animate-on-scroll">
          <div class="feature-icon" set:html={f.icon} />
          <h3 class="heading-3">{f.title}</h3>
          <p class="body-sm">{f.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .feature-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .feature-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-glass);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    color: var(--text-secondary);
    margin-bottom: var(--space-2);
  }

  @media (max-width: 1024px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
