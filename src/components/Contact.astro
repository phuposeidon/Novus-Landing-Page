---
---

<section class="contact section" id="contact" data-od-id="contact-section">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-info">
        <span class="overline animate-on-scroll">Get in Touch</span>
        <h2 class="heading-1 animate-on-scroll text-balance">
          Questions? We'd love to hear from you.
        </h2>
        <p class="body-lg animate-on-scroll">
          Whether you're curious about features, need help with your audit,
          or want to discuss a partnership — our team is ready.
        </p>

        <div class="contact-channels animate-on-scroll">
          <div class="contact-channel">
            <div class="contact-channel-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
            </div>
            <div>
              <div class="contact-channel-label">Email</div>
              <a href="mailto:support@novus-seo.com" class="contact-channel-value">support@novus-seo.com</a>
            </div>
          </div>

          <div class="contact-channel">
            <div class="contact-channel-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
            </div>
            <div>
              <div class="contact-channel-label">Response time</div>
              <span class="contact-channel-value">Within 24 hours</span>
            </div>
          </div>
        </div>
      </div>

      <form
        class="contact-form animate-on-scroll"
        id="contact-form"
        action="#"
        method="POST"
        novalidate
        data-od-id="contact-form"
      >
        <!-- Name -->
        <div class="form-group">
          <label for="contact-name" class="form-label">Name</label>
          <input
            type="text"
            id="contact-name"
            name="name"
            class="form-input"
            placeholder="Your name"
            required
            minlength="2"
            aria-describedby="name-error"
            autocomplete="name"
          />
          <span class="form-error" id="name-error" role="alert" aria-live="polite"></span>
        </div>

        <!-- Email -->
        <div class="form-group">
          <label for="contact-email" class="form-label">Email</label>
          <input
            type="email"
            id="contact-email"
            name="email"
            class="form-input"
            placeholder="you@store.com"
            required
            aria-describedby="email-error"
            autocomplete="email"
          />
          <span class="form-error" id="email-error" role="alert" aria-live="polite"></span>
        </div>

        <!-- Subject -->
        <div class="form-group">
          <label for="contact-subject" class="form-label">Subject</label>
          <select id="contact-subject" name="subject" class="form-input form-select">
            <option value="" disabled selected>Choose a topic</option>
            <option value="general">General inquiry</option>
            <option value="support">Technical support</option>
            <option value="billing">Billing question</option>
            <option value="partnership">Partnership</option>
            <option value="feature">Feature request</option>
          </select>
        </div>

        <!-- Message -->
        <div class="form-group">
          <label for="contact-message" class="form-label">Message</label>
          <textarea
            id="contact-message"
            name="message"
            class="form-input form-textarea"
            placeholder="Tell us how we can help…"
            rows="5"
            required
            minlength="10"
            aria-describedby="message-error"
          ></textarea>
          <span class="form-error" id="message-error" role="alert" aria-live="polite"></span>
        </div>

        <button type="submit" class="btn btn-primary" id="contact-submit" style="width: 100%;">
          Send Message
        </button>

        <!-- Status region — success and server-error messages -->
        <div class="form-status" id="form-status" role="status" aria-live="polite"></div>
      </form>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const form = document.getElementById("contact-form");
    const statusEl = document.getElementById("form-status");
    const submitBtn = document.getElementById("contact-submit");

    // --- Validation messages (adaptive per craft/form-validation.md) ---
    function getErrorMessage(input) {
      if (input.validity.valueMissing) return "This field is required.";
      if (input.validity.typeMismatch && input.type === "email")
        return "Enter a valid email address, e.g. you@store.com.";
      if (input.validity.tooShort)
        return `Must be at least ${input.minLength} characters.`;
      if (input.validity.patternMismatch) return "Please match the requested format.";
      return input.validationMessage || "Invalid value.";
    }

    function showError(input, msg) {
      const errorEl = document.getElementById(input.id.replace("contact-", "") + "-error");
      if (!errorEl) return;
      input.setAttribute("aria-invalid", "true");
      errorEl.textContent = msg;
    }

    function clearError(input) {
      const errorEl = document.getElementById(input.id.replace("contact-", "") + "-error");
      if (!errorEl) return;
      input.removeAttribute("aria-invalid");
      errorEl.textContent = "";
    }

    function validateField(input) {
      if (!input.validity.valid) {
        showError(input, getErrorMessage(input));
        return false;
      }
      clearError(input);
      return true;
    }

    // Blur validation — validate on first blur (form-validation.md rule 1)
    const validatableFields = form.querySelectorAll("[required]");
    validatableFields.forEach((input) => {
      let touched = false;
      input.addEventListener("blur", () => {
        touched = true;
        validateField(input);
      });
      // Once invalid+touched: re-validate on input so error clears as soon as valid (rule 2)
      input.addEventListener("input", () => {
        if (touched) validateField(input);
      });
    });

    // Lock all fields during submit
    function setSubmitting(submitting) {
      validatableFields.forEach((f) => (f.disabled = submitting));
      submitBtn.disabled = submitting;
      submitBtn.textContent = submitting ? "Sending…" : "Send Message";
    }

    // Show server-level error
    function showServerError(msg) {
      statusEl.textContent = msg;
      statusEl.className = "form-status error";
    }

    function showSuccess() {
      statusEl.textContent = "Message sent! We'll get back to you within 24 hours.";
      statusEl.className = "form-status success";
      submitBtn.textContent = "Sent ✓";
      form.reset();
    }

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      statusEl.textContent = "";
      statusEl.className = "form-status";

      // Run all validations on submit (rule 3)
      let firstInvalid = null;
      let allValid = true;
      validatableFields.forEach((input) => {
        if (!validateField(input)) {
          allValid = false;
          if (!firstInvalid) firstInvalid = input;
        }
      });

      if (!allValid) {
        firstInvalid.focus();
        return;
      }

      setSubmitting(true);

      // Simulate submission — replace with real endpoint fetch()
      setTimeout(() => {
        const success = true; // flip to false to test error state
        if (success) {
          showSuccess();
          setSubmitting(false);
          submitBtn.disabled = true; // keep disabled until next timeout
          setTimeout(() => {
            submitBtn.disabled = false;
            submitBtn.textContent = "Send Message";
            statusEl.textContent = "";
            statusEl.className = "form-status";
          }, 5000);
        } else {
          setSubmitting(false);
          showServerError("Something went wrong on our end. Please try again or email us directly.");
        }
      }, 1200);
    });
  })();
</script>

<style>
  .contact {
    background: var(--bg-section);
    border-top: 1px solid var(--border);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    align-items: start;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .contact-channels {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .contact-channel {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .contact-channel-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-glass);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    color: var(--text-secondary);
  }

  .contact-channel-label {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 2px;
  }

  .contact-channel-value {
    font-size: 15px;
    color: var(--text-primary);
    font-weight: 500;
  }

  a.contact-channel-value:hover {
    color: var(--accent);
  }

  /* Form */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    background: var(--bg-deep);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-secondary);
    letter-spacing: 0.01em;
  }

  .form-input {
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--text-primary);
    background: var(--bg-void);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 12px 14px;
    outline: none;
    transition: border-color var(--duration-fast), box-shadow var(--duration-fast);
    width: 100%;
  }

  .form-input::placeholder {
    color: var(--text-faint);
  }

  .form-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(54, 244, 164, 0.08);
  }

  /* :user-invalid — shows ONLY after user interaction (form-validation.md) */
  .form-input:user-invalid,
  .form-input[aria-invalid="true"] {
    border-color: #ef4444;
    box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.08);
  }

  .form-error {
    font-size: 12px;
    color: #f87171;
    min-height: 16px;
    line-height: 1.4;
  }

  .form-select {
    appearance: none;
    background-image: url("data:image/svg+xml,%3Csvg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='%238b8b95' stroke-width='2' xmlns='http://www.w3.org/2000/svg'%3E%3Cpolyline points='6 9 12 15 18 9'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 14px center;
    padding-right: 36px;
    cursor: pointer;
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
    line-height: 1.5;
  }

  .form-status {
    font-size: 14px;
    text-align: center;
    min-height: 20px;
    border-radius: var(--radius-md);
    padding: 0;
    transition: all var(--duration-normal);
  }

  .form-status.success {
    color: var(--accent);
    font-weight: 500;
    background: rgba(54, 244, 164, 0.06);
    border: 1px solid rgba(54, 244, 164, 0.15);
    padding: 10px 14px;
  }

  .form-status.error {
    color: #f87171;
    font-weight: 500;
    background: rgba(239, 68, 68, 0.06);
    border: 1px solid rgba(239, 68, 68, 0.15);
    padding: 10px 14px;
  }

  @media (max-width: 1024px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }
  }

  @media (max-width: 375px) {
    .contact-form {
      padding: var(--space-4);
    }
  }
</style>
