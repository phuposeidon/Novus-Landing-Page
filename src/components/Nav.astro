---
import { BLOG_URL, SHOPIFY_INSTALL_URL, siteAnchors } from "../config/site.ts";
import BrandLogo from "./BrandLogo.astro";
---

<header class="nav" id="nav" data-od-id="nav">
  <div class="nav-inner container">
    <a href="/" class="nav-logo" aria-label="Nexis CRO home">
      <BrandLogo size={34} showWordmark />
    </a>

    <nav class="nav-links" aria-label="Main navigation">
      <a href={siteAnchors.features} data-analytics-event="nav_anchor_click" data-analytics-section="features" data-analytics-location="nav">Features</a>
      <a href={siteAnchors.howItWorks} data-analytics-event="nav_anchor_click" data-analytics-section="how-it-works" data-analytics-location="nav">How It Works</a>
      <a href={siteAnchors.pricing} data-analytics-event="nav_anchor_click" data-analytics-section="pricing" data-analytics-location="nav">Pricing</a>
      <a href={BLOG_URL} data-analytics-event="nav_anchor_click" data-analytics-section="blog" data-analytics-location="nav">Blog</a>
      <a href={siteAnchors.faq} data-analytics-event="nav_anchor_click" data-analytics-section="faq" data-analytics-location="nav">FAQ</a>
      <a href={siteAnchors.contact} data-analytics-event="nav_anchor_click" data-analytics-section="contact" data-analytics-location="nav">Contact</a>
    </nav>

    <a
      href={SHOPIFY_INSTALL_URL}
      class="btn btn-primary btn-sm nav-cta"
      id="nav-cta"
      target="_blank"
      rel="noopener noreferrer"
      data-analytics-event="install_click"
      data-analytics-location="nav"
    >
      Install Free on Shopify
    </a>

    <button type="button" class="nav-toggle" id="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-mobile">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <line x1="4" y1="7" x2="20" y2="7" class="line-top" />
        <line x1="4" y1="12" x2="20" y2="12" class="line-mid" />
        <line x1="4" y1="17" x2="20" y2="17" class="line-bot" />
      </svg>
    </button>
  </div>
</header>

<!-- Mobile menu: sibling of header so fixed positioning isn't clipped by nav backdrop-filter -->
<div class="nav-mobile" id="nav-mobile" aria-hidden="true">
  <nav class="nav-mobile-links" aria-label="Mobile navigation">
    <a href={siteAnchors.features} data-analytics-event="nav_anchor_click" data-analytics-section="features" data-analytics-location="nav_mobile">Features</a>
    <a href={siteAnchors.howItWorks} data-analytics-event="nav_anchor_click" data-analytics-section="how-it-works" data-analytics-location="nav_mobile">How It Works</a>
    <a href={siteAnchors.pricing} data-analytics-event="nav_anchor_click" data-analytics-section="pricing" data-analytics-location="nav_mobile">Pricing</a>
    <a href={BLOG_URL} data-analytics-event="nav_anchor_click" data-analytics-section="blog" data-analytics-location="nav_mobile">Blog</a>
    <a href={siteAnchors.faq} data-analytics-event="nav_anchor_click" data-analytics-section="faq" data-analytics-location="nav_mobile">FAQ</a>
    <a href={siteAnchors.contact} data-analytics-event="nav_anchor_click" data-analytics-section="contact" data-analytics-location="nav_mobile">Contact</a>
    <a
      href={SHOPIFY_INSTALL_URL}
      class="btn btn-primary nav-mobile-cta"
      target="_blank"
      rel="noopener noreferrer"
      data-analytics-event="install_click"
      data-analytics-location="nav_mobile"
    >
      Install Free on Shopify
    </a>
  </nav>
</div>

<script is:inline>
  (function initMobileNav() {
    const nav = document.getElementById("nav");
    const toggle = document.getElementById("nav-toggle");
    const mobile = document.getElementById("nav-mobile");
    if (!nav || !toggle || !mobile) return;

    const onScroll = () => nav.classList.toggle("scrolled", window.scrollY > 40);
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    function setMobileMenu(open) {
      toggle.setAttribute("aria-expanded", String(open));
      mobile.classList.toggle("is-open", open);
      mobile.setAttribute("aria-hidden", String(!open));
      nav.classList.toggle("nav-menu-open", open);
      document.body.classList.toggle("nav-open", open);
      document.body.style.overflow = open ? "hidden" : "";
    }

    toggle.addEventListener("click", (event) => {
      event.preventDefault();
      event.stopPropagation();
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      setMobileMenu(!expanded);
    });

    mobile.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setMobileMenu(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setMobileMenu(false);
      }
    });
  })();
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out);
  }

  .nav.scrolled {
    background: rgba(6, 26, 28, 0.85);
    border-bottom-color: var(--border);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-height);
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    letter-spacing: -0.02em;
  }

  .nav-links {
    display: flex;
    gap: var(--space-6);
  }

  .nav-links a {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: color var(--duration-fast);
    letter-spacing: 0.01em;
    padding: 4px 2px;
    border-radius: 3px;
  }

  .nav-links a:hover {
    color: var(--text-primary);
  }

  .nav-links a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    color: var(--text-primary);
  }

  .nav-cta {
    font-size: 14px;
  }

  .nav-toggle {
    display: none;
    position: relative;
    z-index: 102;
    background: none;
    border: none;
    color: var(--text-primary);
    cursor: pointer;
    padding: 10px;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    -webkit-tap-highlight-color: transparent;
  }

  .nav.nav-menu-open {
    background: rgba(0, 0, 0, 0.98);
    border-bottom-color: var(--border);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  @media (max-width: 768px) {
    .nav-links,
    .nav-cta {
      display: none !important;
    }

    .nav-toggle {
      display: flex;
    }
  }
</style>
