---
import { BLOG_URL, QUIZSIGNAL, SHOPIFY_INSTALL_URL, siteAnchors } from "../config/site.ts";
import BrandLogo from "./BrandLogo.astro";
---

<header class="nav" id="nav" data-od-id="nav">
  <div class="nav-inner container">
    <a href="/" class="nav-logo" aria-label="Nexis CRO home">
      <BrandLogo size={34} showWordmark />
    </a>

    <nav class="nav-links" aria-label="Main navigation">
      <div class="nav-dropdown">
        <button type="button" class="nav-dropdown-trigger" aria-haspopup="true" aria-expanded="false">
          Apps
          <svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div class="nav-dropdown-menu" role="menu">
          <a href={siteAnchors.aiSeo} class="nav-dropdown-item" role="menuitem" data-analytics-event="nav_anchor_click" data-analytics-section="ai-seo" data-analytics-location="nav">
            <div class="nav-item-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </div>
            <div class="nav-item-text">
              <span class="nav-item-title">AI SEO & AEO Audit</span>
              <span class="nav-item-desc">ChatGPT & Perplexity visibility</span>
            </div>
            <span class="nav-badge-pill">AI Search</span>
          </a>
          <a href={QUIZSIGNAL.hub} class="nav-dropdown-item" role="menuitem" data-analytics-event="nav_link_click" data-analytics-section="quizsignal" data-analytics-location="nav">
            <div class="nav-item-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"></path>
              </svg>
            </div>
            <div class="nav-item-text">
              <span class="nav-item-title">Quiz Signal</span>
              <span class="nav-item-desc">Recommendation quiz funnels</span>
            </div>
            <span class="nav-badge-pill">Storefront CRO</span>
          </a>
        </div>
      </div>
      <a href={siteAnchors.howItWorks} data-analytics-event="nav_anchor_click" data-analytics-section="how-it-works" data-analytics-location="nav">How It Works</a>
      <a href={siteAnchors.features} data-analytics-event="nav_anchor_click" data-analytics-section="features" data-analytics-location="nav">Features</a>
      <a href={siteAnchors.pricing} data-analytics-event="nav_anchor_click" data-analytics-section="pricing" data-analytics-location="nav">Pricing</a>
      <a href={BLOG_URL} data-analytics-event="nav_anchor_click" data-analytics-section="blog" data-analytics-location="nav">Blog</a>
      <a href={siteAnchors.faq} data-analytics-event="nav_anchor_click" data-analytics-section="faq" data-analytics-location="nav">FAQ</a>
      <a href={siteAnchors.contact} data-analytics-event="nav_anchor_click" data-analytics-section="contact" data-analytics-location="nav">Contact</a>
    </nav>

    <div class="nav-cta-group">
      <!-- Theme Switcher Button -->
      <button
        type="button"
        class="theme-toggle-btn"
        id="theme-toggle"
        aria-label="Toggle color theme"
        title="Toggle color theme"
      >
        <svg class="sun-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg class="moon-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <a
        href={SHOPIFY_INSTALL_URL}
        class="btn btn-primary btn-sm nav-cta"
        id="nav-cta"
        target="_blank"
        rel="noopener noreferrer"
        data-analytics-event="install_click"
        data-analytics-location="nav"
      >
        Install Free on Shopify
      </a>
    </div>

    <button type="button" class="nav-toggle" id="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-mobile">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <line x1="4" y1="7" x2="20" y2="7" class="line-top" />
        <line x1="4" y1="12" x2="20" y2="12" class="line-mid" />
        <line x1="4" y1="17" x2="20" y2="17" class="line-bot" />
      </svg>
    </button>
  </div>
</header>

<!-- Mobile menu: sibling of header so fixed positioning isn't clipped by nav backdrop-filter -->
<div class="nav-mobile" id="nav-mobile" aria-hidden="true">
  <nav class="nav-mobile-links" aria-label="Mobile navigation">
    <div class="nav-mobile-theme-row">
      <span class="mobile-theme-lbl">Appearance</span>
      <button type="button" class="theme-toggle-btn theme-toggle-btn--mobile" id="theme-toggle-mobile" aria-label="Toggle theme">
        <svg class="sun-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg class="moon-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <span class="theme-toggle-label">Switch Theme</span>
      </button>
    </div>
    <div class="nav-mobile-group-title">Shopify Apps</div>
    <a href={siteAnchors.aiSeo} class="nav-mobile-app-link" data-analytics-event="nav_anchor_click" data-analytics-section="ai-seo" data-analytics-location="nav_mobile">
      <span>AI SEO &amp; AEO Audit</span>
      <span class="nav-badge-pill">AI Search</span>
    </a>
    <a href={QUIZSIGNAL.hub} class="nav-mobile-app-link" data-analytics-event="nav_link_click" data-analytics-section="quizsignal" data-analytics-location="nav_mobile">
      <span>Quiz Signal</span>
      <span class="nav-badge-pill">Storefront CRO</span>
    </a>
    <div class="nav-mobile-divider"></div>
    <a href={siteAnchors.howItWorks} data-analytics-event="nav_anchor_click" data-analytics-section="how-it-works" data-analytics-location="nav_mobile">How It Works</a>
    <a href={siteAnchors.features} data-analytics-event="nav_anchor_click" data-analytics-section="features" data-analytics-location="nav_mobile">Features</a>
    <a href={siteAnchors.pricing} data-analytics-event="nav_anchor_click" data-analytics-section="pricing" data-analytics-location="nav_mobile">Pricing</a>
    <a href={BLOG_URL} data-analytics-event="nav_anchor_click" data-analytics-section="blog" data-analytics-location="nav_mobile">Blog</a>
    <a href={siteAnchors.faq} data-analytics-event="nav_anchor_click" data-analytics-section="faq" data-analytics-location="nav_mobile">FAQ</a>
    <a href={siteAnchors.contact} data-analytics-event="nav_anchor_click" data-analytics-section="contact" data-analytics-location="nav_mobile">Contact</a>
    <div class="nav-mobile-ctas">
      <a
        href={SHOPIFY_INSTALL_URL}
        class="btn btn-primary nav-mobile-cta"
        target="_blank"
        rel="noopener noreferrer"
        data-analytics-event="install_click"
        data-analytics-location="nav_mobile"
      >
        Install AI SEO App
      </a>
      <a
        href={QUIZSIGNAL.installUrl}
        class="btn btn-ghost nav-mobile-cta"
        target="_blank"
        rel="noopener noreferrer"
        data-analytics-event="install_click"
        data-analytics-location="nav_mobile"
      >
        Install Quiz Signal
      </a>
    </div>
  </nav>
</div>

<script is:inline>
  (function initNavAndTheme() {
    // Theme toggle handling
    function toggleTheme() {
      const current = document.documentElement.getAttribute("data-theme") || "light";
      const next = current === "dark" ? "light" : "dark";
      document.documentElement.setAttribute("data-theme", next);
      try {
        localStorage.setItem("theme", next);
      } catch (e) {}
    }

    document.getElementById("theme-toggle")?.addEventListener("click", toggleTheme);
    document.getElementById("theme-toggle-mobile")?.addEventListener("click", toggleTheme);

    const nav = document.getElementById("nav");
    const toggle = document.getElementById("nav-toggle");
    const mobile = document.getElementById("nav-mobile");
    if (!nav || !toggle || !mobile) return;

    const onScroll = () => nav.classList.toggle("scrolled", window.scrollY > 40);
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    function setMobileMenu(open) {
      toggle.setAttribute("aria-expanded", String(open));
      mobile.classList.toggle("is-open", open);
      mobile.setAttribute("aria-hidden", String(!open));
      nav.classList.toggle("nav-menu-open", open);
      document.body.classList.toggle("nav-open", open);
      document.body.style.overflow = open ? "hidden" : "";
    }

    toggle.addEventListener("click", (event) => {
      event.preventDefault();
      event.stopPropagation();
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      setMobileMenu(!expanded);
    });

    mobile.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setMobileMenu(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setMobileMenu(false);
      }
    });
  })();
</script>


<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out);
  }

  .nav.scrolled {
    background: var(--nav-bg-scrolled);
    border-bottom-color: var(--border);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-height);
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    letter-spacing: -0.02em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .nav-links a {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: color var(--duration-fast);
    letter-spacing: 0.01em;
    padding: 4px 2px;
    border-radius: 3px;
  }

  .nav-links a:hover {
    color: var(--text-primary);
  }

  .nav-links a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    color: var(--text-primary);
  }

  /* Dropdown for Apps */
  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px 8px;
    border-radius: var(--radius-sm);
    transition: color var(--duration-fast), background var(--duration-fast);
  }

  .nav-dropdown-trigger:hover,
  .nav-dropdown:hover .nav-dropdown-trigger,
  .nav-dropdown:focus-within .nav-dropdown-trigger {
    color: var(--text-primary);
    background: var(--bg-glass);
  }

  .dropdown-chevron {
    transition: transform var(--duration-fast);
  }

  .nav-dropdown:hover .dropdown-chevron,
  .nav-dropdown:focus-within .dropdown-chevron {
    transform: rotate(180deg);
  }

  .nav-dropdown-menu {
    position: absolute;
    top: calc(100% + 8px);
    left: -10px;
    width: 290px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-2);
    box-shadow: var(--shadow-elevated);
    display: none;
    flex-direction: column;
    gap: 4px;
    z-index: 110;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .nav-dropdown:hover .nav-dropdown-menu,
  .nav-dropdown:focus-within .nav-dropdown-menu {
    display: flex;
    animation: dropdownFadeIn 150ms var(--ease-out);
  }

  @keyframes dropdownFadeIn {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .nav-dropdown-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px !important;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: background var(--duration-fast) !important;
  }

  .nav-dropdown-item:hover {
    background: var(--bg-glass-hover);
  }

  .nav-item-icon {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    background: var(--accent-dim);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .nav-item-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
  }

  .nav-item-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .nav-item-desc {
    font-size: 11px;
    color: var(--text-muted);
  }

  .nav-badge-pill {
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px 6px;
    border-radius: var(--radius-pill);
    background: var(--accent-dim);
    color: var(--accent);
    border: 1px solid rgba(5, 150, 105, 0.25);
    white-space: nowrap;
  }

  [data-theme="dark"] .nav-badge-pill {
    border-color: rgba(54, 244, 164, 0.25);
  }

  .nav-cta-group {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .nav-cta {
    font-size: 13px;
  }

  /* Theme Toggle Button */
  .theme-toggle-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-pill);
    background: var(--bg-glass);
    border: 1px solid var(--border);
    color: var(--text-primary);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
    padding: 0;
    flex-shrink: 0;
  }

  .theme-toggle-btn:hover {
    background: var(--bg-glass-hover);
    border-color: var(--border-hover);
    transform: scale(1.05);
  }

  /* Light mode (default): show moon (switch to dark), hide sun */
  :root .sun-icon,
  [data-theme="light"] .sun-icon {
    display: none;
  }

  :root .moon-icon,
  [data-theme="light"] .moon-icon {
    display: block;
  }

  /* Dark mode: show sun (switch to light), hide moon */
  [data-theme="dark"] .sun-icon {
    display: block;
  }

  [data-theme="dark"] .moon-icon {
    display: none;
  }

  .nav-toggle {
    display: none;
    position: relative;
    z-index: 102;
    background: none;
    border: none;
    color: var(--text-primary);
    cursor: pointer;
    padding: 10px;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    -webkit-tap-highlight-color: transparent;
  }

  .nav.nav-menu-open {
    background: var(--nav-mobile-bg);
    border-bottom-color: var(--border);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  /* Mobile menu styles */
  .nav-mobile {
    display: none;
    position: fixed;
    top: var(--nav-height);
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--nav-mobile-bg);
    z-index: 99;
    padding: var(--space-6) var(--space-5);
    overflow-y: auto;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .nav-mobile.is-open {
    display: block;
  }

  .nav-mobile-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .nav-mobile-theme-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    background: var(--bg-glass);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-2);
  }

  .mobile-theme-lbl {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .theme-toggle-btn--mobile {
    width: auto;
    height: auto;
    padding: 6px 12px;
    gap: 8px;
    font-size: 12px;
    font-weight: 500;
  }

  .theme-toggle-label {
    font-size: 12px;
    color: var(--text-primary);
  }

  .nav-mobile-group-title {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 2px;
  }

  .nav-mobile-app-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    background: var(--bg-glass);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
  }

  .nav-mobile-divider {
    height: 1px;
    background: var(--border);
    margin: var(--space-2) 0;
  }

  .nav-mobile-links a {
    font-size: 16px;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 6px 0;
  }

  .nav-mobile-links a:hover {
    color: var(--accent);
  }

  .nav-mobile-ctas {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  @media (max-width: 860px) {
    .nav-links,
    .nav-cta-group {
      display: none !important;
    }

    .nav-toggle {
      display: flex;
    }
  }
</style>
