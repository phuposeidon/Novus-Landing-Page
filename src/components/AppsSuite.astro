---
import { QUIZSIGNAL, SHOPIFY_INSTALL_URL, siteAnchors } from "../config/site.ts";
---

<section class="apps-suite section" id="apps">
  <div class="container">
    <div class="apps-suite-header text-center">
      <span class="overline animate-on-scroll">The Nexis CRO Ecosystem</span>
      <h2 class="display animate-on-scroll text-balance">
        Two Focused Apps. Complete Shopify Growth Engine.
      </h2>
      <p class="body-lg animate-on-scroll" style="max-width: 54ch; margin: var(--space-3) auto 0;">
        Win on both ends of the funnel: attract high-intent AI search traffic with AEO audits, and convert browsers into buyers with smart recommendation quizzes.
      </p>
    </div>

    <div class="apps-grid">
      <!-- App 1: AI SEO & AEO Audit -->
      <div class="app-card animate-on-scroll" id="ai-seo">
        <div class="app-card-top">
          <div class="app-tag-pill traffic">
            <span class="dot"></span>
            Top-of-Funnel &middot; AI Search &amp; AEO
          </div>
          <div class="app-icon-wrap ai-seo-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </div>
        </div>

        <div class="app-card-body">
          <h3 class="app-title">Nexis CRO: AI SEO &amp; AEO Audit</h3>
          <p class="app-desc">
            Audit your store's discoverability across ChatGPT, Perplexity, Gemini, and Google AI Overviews. Fix broken signals, inject rich schema, and deploy auto-updating llms.txt in minutes.
          </p>

          <!-- 3D UI Preview Art Frame -->
          <div class="app-visual-frame">
            <img
              src="/assets/ai_seo_radar.jpg"
              alt="Nexis CRO AI Search & AEO Citation Radar"
              width="560"
              height="315"
              loading="lazy"
              class="app-visual-img"
            />
            <div class="visual-badge-overlay">
              <span class="pulse-dot"></span>
              <span>Live AI Citation Engine</span>
            </div>
          </div>

          <div class="app-features-list">
            <div class="app-feature-item">
              <span class="feat-icon">✓</span>
              <span><strong>AI Rank &amp; SOV Tracker:</strong> Track store citations against competitors.</span>
            </div>
            <div class="app-feature-item">
              <span class="feat-icon">✓</span>
              <span><strong>Automated llms.txt:</strong> Structured context feeds for AI crawlers.</span>
            </div>
            <div class="app-feature-item">
              <span class="feat-icon">✓</span>
              <span><strong>JSON-LD Schema Blocks:</strong> Turnkey structured data for 8 page types.</span>
            </div>
            <div class="app-feature-item">
              <span class="feat-icon">✓</span>
              <span><strong>AI Quick Fixes:</strong> 1-click meta rewrites &amp; policy generator.</span>
            </div>
          </div>
        </div>

        <div class="app-card-footer">
          <div class="app-pricing-hint">
            <span class="price-val">Free plan</span>
            <span class="price-sub">&middot; Pro from $9/mo</span>
          </div>
          <div class="app-btn-group">
            <a
              href={siteAnchors.features}
              class="btn btn-ghost btn-sm"
              data-analytics-event="nav_anchor_click"
              data-analytics-section="features"
              data-analytics-location="apps_suite"
            >
              See AI Features
            </a>
            <a
              href={SHOPIFY_INSTALL_URL}
              class="btn btn-primary btn-sm"
              target="_blank"
              rel="noopener noreferrer"
              data-analytics-event="install_click"
              data-analytics-location="apps_suite_aiseo"
            >
              Install Free ↗
            </a>
          </div>
        </div>
      </div>

      <!-- App 2: Quiz Signal -->
      <div class="app-card animate-on-scroll app-card--highlight" id="quizsignal-card">
        <div class="app-card-top">
          <div class="app-tag-pill cro">
            <span class="dot"></span>
            Storefront &middot; Conversion Rate Optimization
          </div>
          <div class="app-icon-wrap quiz-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"></path>
            </svg>
          </div>
        </div>

        <div class="app-card-body">
          <h3 class="app-title">Nexis CRO: Quiz Signal</h3>
          <p class="app-desc">
            Build engaging storefront recommendation quizzes that match shoppers with the exact right products. Capture zero-party customer data and boost average order value by up to 25%.
          </p>

          <!-- 3D UI Preview Art Frame -->
          <div class="app-visual-frame">
            <img
              src="/assets/quiz_signal_studio.jpg"
              alt="Nexis CRO Quiz Signal Storefront Recommender"
              width="560"
              height="315"
              loading="lazy"
              class="app-visual-img"
            />
            <div class="visual-badge-overlay">
              <span class="pulse-dot"></span>
              <span>98% Match Conversion Studio</span>
            </div>
          </div>


          <div class="app-features-list">
            <div class="app-feature-item">
              <span class="feat-icon">✓</span>
              <span><strong>AI Quiz Maker &amp; Studio:</strong> Generate full quiz funnels in seconds.</span>
            </div>
            <div class="app-feature-item">
              <span class="feat-icon">✓</span>
              <span><strong>Product Match Engine:</strong> Dynamic logic for single items, routines &amp; bundles.</span>
            </div>
            <div class="app-feature-item">
              <span class="feat-icon">✓</span>
              <span><strong>0-Code Theme Block:</strong> Native OS 2.0 app block for any Shopify theme.</span>
            </div>
            <div class="app-feature-item">
              <span class="feat-icon">✓</span>
              <span><strong>Zero-Party Data:</strong> Seamless sync to Klaviyo &amp; Shopify Customer Segments.</span>
            </div>
          </div>
        </div>

        <div class="app-card-footer">
          <div class="app-pricing-hint">
            <span class="price-val">Free plan</span>
            <span class="price-sub">&middot; Growth at $9/mo</span>
          </div>
          <div class="app-btn-group">
            <a
              href={siteAnchors.quizsignal}
              class="btn btn-ghost btn-sm"
              data-analytics-event="nav_anchor_click"
              data-analytics-section="quizsignal"
              data-analytics-location="apps_suite"
            >
              Quiz Details &amp; Demo
            </a>
            <a
              href={QUIZSIGNAL.installUrl}
              class="btn btn-accent btn-sm"
              target="_blank"
              rel="noopener noreferrer"
              data-analytics-event="install_click"
              data-analytics-location="apps_suite_quiz"
            >
              Install Free
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // 3D Tilt Hover Physics on Flagship App Cards
  document.querySelectorAll(".app-card").forEach((card) => {
    card.addEventListener("mousemove", (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const xPct = (x / rect.width - 0.5) * 2; // -1 to 1
      const yPct = (y / rect.height - 0.5) * 2; // -1 to 1

      if (window.gsap) {
        gsap.to(card, {
          rotateY: xPct * 4,
          rotateX: -yPct * 4,
          transformPerspective: 1000,
          duration: 0.4,
          ease: "power2.out",
        });
      }
    });

    card.addEventListener("mouseleave", () => {
      if (window.gsap) {
        gsap.to(card, {
          rotateX: 0,
          rotateY: 0,
          duration: 0.6,
          ease: "elastic.out(1, 0.4)",
        });
      }
    });
  });
</script>


<style>
  .apps-suite {
    position: relative;
    padding: var(--space-9) 0 var(--space-8);
    background: linear-gradient(180deg, var(--bg-void) 0%, var(--bg-deep) 100%);
    border-bottom: 1px solid var(--border-subtle);
  }

  .apps-suite-header {
    margin-bottom: var(--space-8);
  }

  .apps-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
    max-width: 1140px;
    margin: 0 auto;
  }

  .app-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: var(--space-7);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out);
    position: relative;
    overflow: hidden;
  }

  .app-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-hover);
    box-shadow: var(--shadow-elevated);
  }

  .app-card--highlight {
    border-color: rgba(5, 150, 105, 0.3);
    background: radial-gradient(circle at top right, var(--accent-dim) 0%, var(--bg-elevated) 60%);
  }

  [data-theme="dark"] .app-card--highlight {
    border-color: rgba(54, 244, 164, 0.25);
  }

  .app-card--highlight:hover {
    border-color: var(--accent);
  }

  .app-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-5);
  }

  .app-tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
  }

  .app-tag-pill.traffic {
    background: rgba(2, 132, 199, 0.12);
    color: #0284c7;
    border: 1px solid rgba(2, 132, 199, 0.25);
  }

  [data-theme="dark"] .app-tag-pill.traffic {
    background: rgba(56, 189, 248, 0.12);
    color: #38bdf8;
    border-color: rgba(56, 189, 248, 0.25);
  }

  .app-tag-pill.cro {
    background: var(--accent-dim);
    color: var(--accent);
    border: 1px solid rgba(5, 150, 105, 0.25);
  }

  [data-theme="dark"] .app-tag-pill.cro {
    border-color: rgba(54, 244, 164, 0.25);
  }


  .app-tag-pill .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .app-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-seo-icon {
    background: rgba(56, 189, 248, 0.1);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.2);
  }

  .quiz-icon {
    background: var(--accent-dim);
    color: var(--accent);
    border: 1px solid rgba(54, 244, 164, 0.2);
  }

  .app-card-body {
    flex: 1;
    margin-bottom: var(--space-6);
  }

  .app-title {
    font-size: 22px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: var(--space-3);
    letter-spacing: -0.01em;
  }

  .app-desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: var(--space-5);
  }

  /* Visual 3D Preview Frame */
  .app-visual-frame {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: var(--space-5);
    border: 1px solid var(--border);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
    background: var(--bg-deep);
  }

  .app-visual-img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .app-card:hover .app-visual-img {
    transform: scale(1.03);
  }

  .visual-badge-overlay {
    position: absolute;
    bottom: 10px;
    left: 10px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: rgba(9, 14, 23, 0.82);
    color: #ffffff;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.8); }
  }

  .app-features-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .app-feature-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .app-feature-item strong {
    color: var(--text-primary);
  }

  .feat-icon {
    color: var(--accent);
    font-weight: bold;
    font-size: 13px;
    margin-top: 1px;
    flex-shrink: 0;
  }

  .app-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .app-pricing-hint {
    display: flex;
    align-items: baseline;
    gap: 4px;
  }

  .price-val {
    font-size: 14px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .price-sub {
    font-size: 12px;
    color: var(--text-muted);
  }

  .app-btn-group {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  @media (max-width: 880px) {
    .apps-grid {
      grid-template-columns: 1fr;
    }

    .app-card {
      padding: var(--space-5);
    }
  }

</style>
