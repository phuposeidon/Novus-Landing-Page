---
const faqs = [
  {
    question: "What apps does the Nexis CRO suite include?",
    answer: "Nexis CRO offers two specialized Shopify apps designed to grow your store: (1) Nexis CRO: AI SEO & AEO Audit to ensure your store is cited and ranked by ChatGPT, Perplexity, and Google AI; and (2) Nexis CRO: Quiz Signal to build storefront recommendation quiz funnels that convert visitors into buyers and capture zero-party data. You can install either app independently or both together.",
  },
  {
    question: "Do I need to install both apps, or can I use them separately?",
    answer: "Each app operates completely independently with its own free plan. You can install only AI SEO & AEO Audit if your priority is AI search discovery, or install only Quiz Signal if you want to increase on-site conversion rates with recommendation quizzes. They complement each other perfectly to cover discovery and conversion.",
  },
  {
    question: "What is AEO and why does it matter?",
    answer: "AEO stands for AI Engine Optimization. As AI-powered search engines like ChatGPT, Perplexity, and Google AI Overview become major product discovery channels, your store needs to be optimized for how these engines read, understand, and cite information. Traditional SEO tools don't check for this — Nexis CRO does. Read the full Shopify AEO guide at nexiscro.com/blog/shopify-aeo-guide-2026/",
  },
  {
    question: "How does Quiz Signal work with my Shopify theme and Klaviyo?",
    answer: "Quiz Signal provides a native Online Store 2.0 Theme Block that you can drop into any page or product template with zero coding. It inherits your theme styling automatically. When shoppers complete a quiz, their preferences, product matches, and email addresses sync directly into Klaviyo lists and Shopify Customer Segments.",
  },
  {
    question: "Does Nexis CRO work with any Shopify theme?",
    answer: "Yes. Both apps work with every Shopify theme — free, premium, and custom. Schema Blocks and Quiz blocks are injected via the Theme Editor's native App Embeds and App Blocks, so there's no custom code to maintain.",
  },
  {
    question: "How are AI credits used across the apps?",
    answer: "In the AI SEO app, AI credits power AI Quick Fix, Content Rewrites, and AI Visibility scans. In Quiz Signal, AI credits power the automated AI Quiz Maker to generate questions and match rules from your catalog. Both apps include free monthly credit allotments.",
  },
  {
    question: "What is llms.txt and do I need it?",
    answer: "llms.txt is a standardized file (like robots.txt for AI) that tells AI engines what your store is about, what you sell, and how to cite you. Nexis CRO generates and deploys it automatically. Stores with llms.txt score significantly higher on ChatGPT and Perplexity.",
  },
  {
    question: "Can I manage multiple client stores?",
    answer: "Yes — the AI SEO Agency plan ($44/mo or $29/mo billed annually) lets you manage up to 5 client stores from a single dashboard with 500 AI credits and multi-store rank tracking. Custom multi-store accounts are also available on request.",
  },
  {
    question: "Are there free plans available?",
    answer: "Yes! Both Nexis CRO: AI SEO & AEO Audit and Nexis CRO: Quiz Signal offer permanently free plans on the Shopify App Store with 0 credit card required to get started.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<section class="faq section" id="faq">
  <div class="container">
    <div class="faq-header text-center">
      <span class="overline animate-on-scroll">FAQ</span>
      <h2 class="heading-1 animate-on-scroll">Frequently asked questions</h2>
    </div>

    <div class="faq-list">
      {faqs.map((faq) => (
        <details class="faq-item animate-on-scroll">
          <summary class="faq-question">
            <span>{faq.question}</span>
            <svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </summary>
          <div class="faq-answer">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
  }

  .faq-list {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
  }

  .faq-item {
    border-bottom: 1px solid var(--border);
  }

  .faq-item:first-child {
    border-top: 1px solid var(--border);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 20px 0;
    cursor: pointer;
    font-size: 16px;
    font-weight: 500;
    color: var(--text-primary);
    list-style: none;
    transition: color var(--duration-fast);
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question::marker {
    content: "";
  }

  .faq-question:hover {
    color: var(--accent);
  }

  .faq-chevron {
    flex-shrink: 0;
    color: var(--text-muted);
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 0 20px;
  }

  .faq-answer p {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 60ch;
  }
</style>
