---
const faqs = [
  {
    question: "What is AEO and why does it matter?",
    answer: "AEO stands for AI Engine Optimization. As AI-powered search engines like ChatGPT, Perplexity, and Google AI Overview become major product discovery channels, your store needs to be optimized for how these engines read, understand, and cite information. Traditional SEO tools don't check for this — Nexis CRO does. Read the full Shopify AEO guide at nexiscro.com/blog/shopify-aeo-guide-2026/",
  },
  {
    question: "Does Nexis CRO work with any Shopify theme?",
    answer: "Yes. Nexis CRO works with every Shopify theme — free, premium, and custom. Schema Blocks are injected via the Theme Editor's App Embeds feature, so there's no code to write. The audit engine reads your storefront directly, regardless of theme.",
  },
  {
    question: "How are AI credits used?",
    answer: "AI credits power the smart features: AI Quick Fix, Content Rewrite, Image Alt Text generation, and AI Visibility scans. Each action costs 1 credit. Free plans include 5 credits/month, and paid plans include 100-500. You can also buy one-time credit packs that never expire.",
  },
  {
    question: "What's the difference between a Standard and Deep scan?",
    answer: "Standard scans check your store's content, schema, and meta signals — fast and free. Deep scans use AI credits to analyze how AI engines actually respond to queries about your store, giving you platform-specific scores and detailed recommendations.",
  },
  {
    question: "What is llms.txt and do I need it?",
    answer: "llms.txt is a standardized file (like robots.txt for AI) that tells AI engines what your store is about, what you sell, and how to cite you. Nexis CRO generates and deploys it automatically. Stores with llms.txt score significantly higher on ChatGPT and Perplexity.",
  },
  {
    question: "Can I manage multiple stores?",
    answer: "Yes — the Agency plan ($149/mo or $119/mo billed annually) lets you manage up to 5 child stores from a single dashboard. Each store gets its own audit, scores, and issue tracking. Perfect for agencies and Shopify Plus merchants with multiple brands.",
  },
  {
    question: "Is there a free trial?",
    answer: "The Free plan is permanently free with 5 AI credits/month and 1 audit/month — no trial period, no credit card required. You can upgrade to Pro, Growth, or Agency anytime from within the app.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<section class="faq section" id="faq">
  <div class="container">
    <div class="faq-header text-center">
      <span class="overline animate-on-scroll">FAQ</span>
      <h2 class="heading-1 animate-on-scroll">Frequently asked questions</h2>
    </div>

    <div class="faq-list">
      {faqs.map((faq) => (
        <details class="faq-item animate-on-scroll">
          <summary class="faq-question">
            <span>{faq.question}</span>
            <svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </summary>
          <div class="faq-answer">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
  }

  .faq-list {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
  }

  .faq-item {
    border-bottom: 1px solid var(--border);
  }

  .faq-item:first-child {
    border-top: 1px solid var(--border);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 20px 0;
    cursor: pointer;
    font-size: 16px;
    font-weight: 500;
    color: var(--text-primary);
    list-style: none;
    transition: color var(--duration-fast);
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question::marker {
    content: "";
  }

  .faq-question:hover {
    color: var(--accent);
  }

  .faq-chevron {
    flex-shrink: 0;
    color: var(--text-muted);
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 0 20px;
  }

  .faq-answer p {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 60ch;
  }
</style>
