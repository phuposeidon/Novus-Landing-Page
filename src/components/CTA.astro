---
import { BLOG_URL, SHOPIFY_INSTALL_URL } from "../config/site.ts";
---

<section class="cta-band">
  <div class="cta-glow" aria-hidden="true"></div>
  <div class="container cta-inner">
    <h2 class="display animate-on-scroll text-balance">
      Start optimizing for AI search.<br/>Free.
    </h2>
    <p class="body-lg animate-on-scroll" style="max-width: 48ch; margin: 0 auto; opacity: 0.85;">
      Install Nexis CRO on your Shopify store. Run your first audit in 60 seconds.
      No credit card. No trial period. Just answers.
    </p>
    <div class="cta-actions animate-on-scroll">
      <a
        href={SHOPIFY_INSTALL_URL}
        class="btn btn-primary"
        id="cta-final"
        target="_blank"
        rel="noopener noreferrer"
        data-analytics-event="install_click"
        data-analytics-location="cta_final"
      >
        Install Free on Shopify
      </a>
      <a
        href={BLOG_URL}
        class="btn btn-ghost"
        data-analytics-event="nav_anchor_click"
        data-analytics-location="cta_final"
        data-analytics-section="blog"
      >
        Read AEO guides
      </a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    padding: var(--space-10) 0;
    background: var(--bg-elevated);
    border-top: 1px solid var(--border);
    overflow: hidden;
    text-align: center;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
    margin-top: var(--space-6);
  }

  .cta-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 400px;
    background: radial-gradient(
      ellipse at center,
      rgba(54, 244, 164, 0.08) 0%,
      transparent 60%
    );
    pointer-events: none;
  }

  .cta-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
  }
</style>
