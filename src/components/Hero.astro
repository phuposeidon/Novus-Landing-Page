---
import { QUIZSIGNAL, SHOPIFY_INSTALL_URL, siteAnchors } from "../config/site.ts";

/** Centered in viewBox 0 0 36 36 — do not change rx without updating M18 y */
const DONUT_PATH =
  "M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831";
---

<section class="hero" id="hero">
  <!-- Ambient glow -->
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="container hero-content">
    <div class="hero-badge">
      <span class="badge hero-pill-badge">
        <span class="hero-stars" aria-label="5 stars">★★★★★</span>
        <span class="badge-text">Rated 5.0 on Shopify App Store · Built for Shopify</span>
      </span>
    </div>

    <h1 class="display-xl text-balance">
      AI Search Traffic &amp; <br />Storefront Conversion.
    </h1>

    <p class="body-lg hero-sub hero-sub--desktop">
      The complete Shopify growth suite. Get cited and recommended on ChatGPT &amp; Perplexity with
      <strong class="text-white">AI SEO &amp; AEO Audit</strong>, then turn shoppers into buyers with
      <strong class="text-white">Quiz Signal</strong> recommendation funnels.
    </p>
    <p class="body-lg hero-sub hero-sub--mobile">
      Attract AI search traffic with AI SEO Audit and convert shoppers with Quiz Signal recommendation funnels.
    </p>

    <div class="hero-cta-group">
      <div class="hero-cta">
        <a
          href={SHOPIFY_INSTALL_URL}
          class="btn btn-primary"
          id="hero-cta-primary"
          target="_blank"
          rel="noopener noreferrer"
          data-analytics-event="install_click"
          data-analytics-location="hero"
        >
          Install Free on Shopify
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </a>
        <a
          href={siteAnchors.quizsignal}
          class="btn btn-ghost"
          id="hero-cta-secondary"
          data-analytics-event="cta_secondary_click"
          data-analytics-location="hero"
          data-analytics-section="quizsignal"
        >
          Explore Quiz Funnels →
        </a>
      </div>

      <div class="hero-guarantees">
        <span class="hero-guarantee-chip">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          No theme code modified
        </span>
        <span class="hero-guarantee-chip">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Zero risk · Cancel anytime
        </span>
        <span class="hero-guarantee-chip">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Instant ChatGPT audit
        </span>
      </div>
    </div>

    <!-- App Selector Switcher -->
    <div class="hero-switcher-bar">
      <button type="button" class="hero-tab-btn active" id="hero-tab-aiseo" data-app="aiseo">
        <span class="hero-tab-icon">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </span>
        <span>1. AI SEO &amp; AEO Engine</span>
        <span class="hero-tab-badge">Traffic &amp; Citations</span>
      </button>
      <button type="button" class="hero-tab-btn" id="hero-tab-quiz" data-app="quiz">
        <span class="hero-tab-icon">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"></path>
          </svg>
        </span>
        <span>2. Quiz Signal Funnels</span>
        <span class="hero-tab-badge">Storefront CRO</span>
      </button>
    </div>


    <!-- Real High-Fidelity App Dashboard Mockup -->
    <div class="hero-card" id="hero-card">
      <div class="hero-card-header">
        <div class="hero-card-dot" style="background: #ef4444;" aria-hidden="true"></div>
        <div class="hero-card-dot" style="background: #f59e0b;" aria-hidden="true"></div>
        <div class="hero-card-dot" style="background: var(--accent);" aria-hidden="true"></div>
        <span class="hero-card-title" id="hero-window-title">Shopify Admin — Nexis: AI SEO &amp; AEO Audit</span>
      </div>


      <!-- VIEW 1: AI SEO DASHBOARD -->
      <div class="hero-dashboard-inner app-view" id="view-aiseo">
        <!-- Top 4 Analytics Cards Grid -->
        <div class="metrics-grid">
          <!-- Card 1: AEO Score -->
          <div class="metric-card">
            <div class="metric-header">
              <span class="metric-title">AEO SCORE</span>
              <span class="status-badge stable">Stable</span>
            </div>
            <div class="metric-content">
              <div class="score-circle-wrapper">
                <svg class="circle-svg" width="72" height="72" viewBox="0 0 36 36">
                  <path class="circle-bg" d={DONUT_PATH} fill="none" stroke="var(--border)" stroke-width="2.5" />
                  <path class="circle-fill good" stroke-dasharray="76, 100" d={DONUT_PATH} fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" />
                </svg>
                <div class="circle-text">
                  <span class="score-num mono" data-target="76">0</span>
                  <span class="score-total">/100</span>
                </div>
              </div>
              <div class="metric-details">
                <div class="tag-row">
                  <span class="detail-tag warning">Reach 80+</span>
                  <span class="detail-tag critical">Has critical</span>
                </div>
                <span class="detail-desc">Discoverability: <strong class="text-white mono">58</strong></span>
              </div>
            </div>
          </div>

          <!-- Card 2: Resolution Rate -->
          <div class="metric-card">
            <div class="metric-header">
              <span class="metric-title">RESOLUTION RATE</span>
              <span class="status-badge progress">In progress</span>
            </div>
            <div class="metric-content">
              <div class="score-circle-wrapper">
                <svg class="circle-svg" width="72" height="72" viewBox="0 0 36 36">
                  <path class="circle-bg" d={DONUT_PATH} fill="none" stroke="var(--border)" stroke-width="2.5" />
                  <path class="circle-fill warning" stroke-dasharray="21, 100" d={DONUT_PATH} fill="none" stroke="#f59e0b" stroke-width="2.5" stroke-linecap="round" />
                </svg>
                <div class="circle-text">
                  <span class="score-num mono" data-target="21">0</span>
                  <span class="score-total">%</span>
                </div>
              </div>
              <div class="metric-details">
                <span class="detail-desc detail-desc-emphasis"><strong class="text-white">3 of 14</strong> fixed</span>
                <span class="detail-desc">3 resolved total</span>
              </div>
            </div>
          </div>

          <!-- Card 3: Open Issues -->
          <div class="metric-card">
            <div class="metric-header">
              <span class="metric-title">OPEN ISSUES</span>
              <span class="status-badge critical-bg">1 Critical</span>
            </div>
            <div class="metric-content">
              <div class="score-circle-wrapper">
                <svg class="circle-svg" width="72" height="72" viewBox="0 0 36 36">
                  <path class="circle-bg" d={DONUT_PATH} fill="none" stroke="var(--border)" stroke-width="2.5" />
                  <path class="circle-fill danger" stroke-dasharray="78, 100" d={DONUT_PATH} fill="none" stroke="#ef4444" stroke-width="2.5" stroke-linecap="round" />
                </svg>
                <div class="circle-text">
                  <span class="score-num mono" data-target="11">0</span>
                  <span class="score-total">open</span>
                </div>
              </div>
              <div class="metric-details">
                <span class="detail-link">Review and fix →</span>
                <span class="detail-desc">14 found in last scan</span>
              </div>
            </div>
          </div>

          <!-- Card 4: AI Credits -->
          <div class="metric-card">
            <div class="metric-header">
              <span class="metric-title">AI CREDITS</span>
              <span class="status-badge unlimited">Unlimited</span>
            </div>
            <div class="metric-content">
              <div class="score-circle-wrapper">
                <svg class="circle-svg" width="72" height="72" viewBox="0 0 36 36">
                  <path class="circle-bg" d={DONUT_PATH} fill="none" stroke="rgba(5, 150, 105, 0.2)" stroke-width="2" stroke-dasharray="3 3" />
                </svg>
                <div class="circle-text circle-text--solo">
                  <span class="score-num infinity-symbol green-text">∞</span>
                </div>
              </div>
              <div class="metric-details">
                <span class="detail-desc detail-desc-emphasis"><strong class="text-white">Full Access</strong></span>
                <span class="detail-desc">Unlimited usage</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Main Split Workspace Layout -->
        <div class="workspace-grid">
          <!-- Left Workspace: What to Fix First -->

          <div class="workspace-left">
            <div class="card-title-bar">
              <div class="flex-align">
                <svg class="info-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="12" y1="8" x2="12" y2="12"/>
                  <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <p class="workspace-heading">What to fix first</p>
              </div>
              <span class="high-impact-tag">HIGH IMPACT</span>
            </div>

            <div class="issues-list">
              <div class="issue-item">
                <div class="issue-info">
                  <span class="issue-name">Refund policy should be present</span>
                  <span class="issue-badge critical">CRITICAL</span>
                </div>
                <span class="issue-cat">Storefront content · Policy and FAQ Coverage</span>
              </div>

              <div class="issue-item">
                <div class="issue-info">
                  <span class="issue-name">Most products should have rich descriptions</span>
                  <span class="issue-badge high">HIGH</span>
                </div>
                <span class="issue-cat">Storefront content · AI Query Readiness</span>
              </div>

              <div class="issue-item">
                <div class="issue-info">
                  <span class="issue-name">Product descriptions should be detailed</span>
                  <span class="issue-badge high">HIGH</span>
                </div>
                <span class="issue-cat">The Complete Snowboard · Product · Catalog Quality</span>
              </div>

              <div class="issue-item">
                <div class="issue-info">
                  <span class="issue-name">Terms policy should be present</span>
                  <span class="issue-badge high">HIGH</span>
                </div>
                <span class="issue-cat">Storefront content · Policy and FAQ Coverage</span>
              </div>
            </div>
          </div>

          <!-- Right Workspace: Choose Audit Depth -->
          <div class="workspace-right">
            <div class="card-title-bar">
              <p class="workspace-heading">Choose audit depth</p>
              <span class="scan-depth-btn">Scan depth</span>
            </div>
            <p class="depth-desc">Start free with Standard, then use Deep or Full for richer AI-grounded scoring.</p>

            <div class="audit-tiers">
              <div class="audit-tier active-tier">
                <div class="tier-header">
                  <span class="tier-name">Deep Scan</span>
                  <span class="tier-cost">1+ up to 2 credits</span>
                </div>
                <p class="tier-desc">Deeper crawl + prioritized issues; optional sampled AI quotability scoring.</p>
                <label class="tier-checkbox">
                  <input type="checkbox" checked disabled />
                  <span>Include AI quotability review (extra credits only when configured)</span>
                </label>
                <button class="tier-btn primary-btn">Run Deep scan</button>
              </div>

              <div class="audit-tier">
                <div class="tier-header">
                  <span class="tier-name">Full Report</span>
                  <span class="tier-cost yellow-text">3 credits</span>
                </div>
                <p class="tier-desc">Largest coverage run — strongest signal for merchants upgrading their full AEO program.</p>
                <button class="tier-btn secondary-btn">Run Full report</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- VIEW 2: QUIZ SIGNAL STUDIO & LIVE PREVIEW -->
      <div class="hero-dashboard-inner app-view is-hidden" id="view-quiz">
        <div class="quiz-hero-preview">
          <!-- Left: Quiz Studio Builder -->
          <div class="dash-panel quiz-builder-panel">
            <div class="card-title-bar">
              <div class="flex-align">
                <span class="quiz-status-dot" aria-hidden="true"></span>
                <p class="workspace-heading">Quiz Studio Builder</p>
              </div>
              <span class="high-impact-tag quiz-live-tag">LIVE ON STOREFRONT</span>
            </div>

            <div class="quiz-builder-steps">
              <div class="quiz-step-card active">
                <div class="quiz-step-header">
                  <span class="quiz-step-badge">STEP 1</span>
                  <span class="quiz-step-q">"What is your primary skincare focus?"</span>
                </div>
                <div class="quiz-chips">
                  <span class="quiz-chip selected">Barrier Repair &amp; Glow <span class="chk">✓</span></span>
                  <span class="quiz-chip">Anti-Aging &amp; Firming</span>
                  <span class="quiz-chip">Blemish &amp; Oil Control</span>
                </div>
              </div>

              <div class="quiz-step-card">
                <div class="quiz-step-header">
                  <span class="quiz-step-badge">STEP 2</span>
                  <span class="quiz-step-q">"What formula texture do you prefer?"</span>
                </div>
                <div class="quiz-chips">
                  <span class="quiz-chip selected">Weightless Hydra-Serum <span class="chk">✓</span></span>
                  <span class="quiz-chip">Rich Moisture Melt</span>
                </div>
              </div>

              <div class="quiz-integration-strip">
                <div class="quiz-integ-icon">⚡</div>
                <div class="quiz-integ-text">
                  <span>Zero-party profile capture: sync answers to <strong>Klaviyo</strong> &amp; <strong>Shopify Customer Segments</strong></span>
                </div>
              </div>
            </div>
          </div>

          <!-- Right: Storefront Recommendation Output -->
          <div class="dash-panel quiz-result-panel">
            <div class="card-title-bar">
              <p class="workspace-heading">Storefront Recommender Output</p>
              <span class="match-score-pill">98% Match</span>
            </div>

            <div class="quiz-match-product">
              <div class="match-badge-ribbon">Top Recommendation</div>
              <div class="match-grid">
                <div class="match-avatar">
                  <div class="product-icon-art">✨</div>
                </div>
                <div class="match-details">
                  <span class="match-routine-tag">Daily Core Routine</span>
                  <h4 class="match-prod-title">Hydra-Barrier Ceramide Glow Elixir</h4>
                  <p class="match-prod-desc">Selected specifically for barrier repair with high-potency ceramides and zero pore-clogging oils.</p>
                  <div class="match-action-row">
                    <div class="match-pricing">
                      <span class="match-current-price mono">$48.00</span>
                      <span class="match-in-stock">In Stock &middot; Ships Free</span>
                    </div>
                    <button type="button" class="tier-btn primary-btn match-btn">Add to Cart &middot; 1-Click</button>
                  </div>
                </div>
              </div>
            </div>

            <div class="quiz-metrics-strip">
              <div class="quiz-stat-card">
                <span class="stat-number mono green-text">78.4%</span>
                <span class="stat-label">Completion Rate</span>
              </div>
              <div class="quiz-stat-card">
                <span class="stat-number mono green-text">+24.6%</span>
                <span class="stat-label">AOV Increase</span>
              </div>
              <div class="quiz-stat-card">
                <span class="stat-number mono green-text">3.8×</span>
                <span class="stat-label">Conversion Rate</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // App Switcher in Hero Mockup (2 Apps: AI SEO & Quiz Signal)
  const tabAiseo = document.getElementById("hero-tab-aiseo");
  const tabQuiz = document.getElementById("hero-tab-quiz");
  const viewAiseo = document.getElementById("view-aiseo");
  const viewQuiz = document.getElementById("view-quiz");
  const windowTitle = document.getElementById("hero-window-title");

  function switchApp(app) {
    tabAiseo?.classList.remove("active");
    tabQuiz?.classList.remove("active");
    viewAiseo?.classList.add("is-hidden");
    viewQuiz?.classList.add("is-hidden");

    if (app === "aiseo") {
      tabAiseo?.classList.add("active");
      viewAiseo?.classList.remove("is-hidden");
      if (window.gsap && viewAiseo) {
        gsap.fromTo(viewAiseo, { opacity: 0.5, y: 5 }, { opacity: 1, y: 0, duration: 0.25, ease: "power2.out" });
      }
      if (windowTitle) windowTitle.textContent = "Shopify Admin — Nexis: AI SEO & AEO Audit";
    } else if (app === "quiz") {
      tabQuiz?.classList.add("active");
      viewQuiz?.classList.remove("is-hidden");
      if (window.gsap && viewQuiz) {
        gsap.fromTo(viewQuiz, { opacity: 0.5, y: 5 }, { opacity: 1, y: 0, duration: 0.25, ease: "power2.out" });
      }
      if (windowTitle) windowTitle.textContent = "Shopify Admin — Nexis: Quiz Signal Studio & Storefront Preview";
    }
  }

  tabAiseo?.addEventListener("click", () => switchApp("aiseo"));
  tabQuiz?.addEventListener("click", () => switchApp("quiz"));




  // GSAP kinetic entrance on page load
  function initHeroAnimations() {
    if (window.gsap) {
      gsap.from(".hero-badge", { y: 20, opacity: 0, duration: 0.7, ease: "power3.out" });
      gsap.from(".hero h1", { y: 30, opacity: 0, duration: 0.9, delay: 0.1, ease: "power3.out" });
      gsap.from(".hero-sub", { y: 20, opacity: 0, duration: 0.8, delay: 0.22, ease: "power3.out" });
      gsap.from(".hero-cta", { y: 20, opacity: 0, duration: 0.8, delay: 0.32, ease: "power3.out" });
      gsap.from(".hero-switcher-bar", { y: 20, opacity: 0, duration: 0.8, delay: 0.42, ease: "power3.out" });
      gsap.from(".hero-card", { y: 35, opacity: 0, duration: 1.0, delay: 0.52, ease: "power3.out" });
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      initHeroAnimations();
      setTimeout(animateScores, 400);
    });
  } else {
    initHeroAnimations();
    setTimeout(animateScores, 400);
  }

  // Animate score counters on load / scroll
  let animated = false;
  function animateScores() {
    if (animated) return;
    animated = true;

    // Animate numbers
    document.querySelectorAll(".score-num").forEach((el) => {
      const target = parseInt(el.dataset.target, 10);
      if (isNaN(target)) return;
      const duration = 1200;
      const start = performance.now();

      const tick = (now) => {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = Math.round(target * eased);
        if (progress < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    });
  }
</script>

<style>
  .hero {
    position: relative;
    padding: calc(var(--nav-height) + 30px) 0 80px;
    display: block;
    overflow: hidden;
    background-color: var(--bg-void);
    background-image: radial-gradient(var(--grid-dot-color) 1px, transparent 1px);
    background-size: 24px 24px;
    background-position: center;
  }


  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: var(--bg-ambient-img);
    background-size: cover;
    background-position: center top;
    opacity: 0.35;
    pointer-events: none;
    z-index: 0;
  }

  [data-theme="dark"] .hero::before {
    opacity: 0.25;
  }


  .hero-glow {
    position: absolute;
    top: -200px;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 600px;
    background: radial-gradient(
      ellipse at center,
      var(--glow-color) 0%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
  }

  .hero-badge {
    margin-bottom: var(--space-3);
  }

  .hero-pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    background: var(--bg-card-inner);
    border: 1px solid var(--border);
    font-size: 13px;
    font-weight: 500;
  }

  .hero-stars {
    color: #f59e0b;
    letter-spacing: 1px;
    font-size: 13px;
  }

  .hero h1 {
    max-width: 16ch;
    margin-bottom: var(--space-3);
  }

  .hero-sub {
    max-width: 52ch;
    margin-bottom: var(--space-4);
  }

  .hero-sub--mobile {
    display: none;
  }

  @media (max-width: 560px) {
    .hero-sub--desktop {
      display: none;
    }

    .hero-sub--mobile {
      display: block;
    }
  }

  .hero-cta-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .hero-cta {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
  }

  .hero-guarantees {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .hero-guarantee-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    color: var(--text-muted);
    background: var(--bg-glass);
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-subtle);
  }


  /* Expanded, High-Fidelity App Dashboard Workspace Mockup */
  .hero-card {
    --dash-label: 11px;
    --dash-badge: 10px;
    --dash-body: 13px;
    --dash-caption: 12px;
    --dash-heading: 15px;
    --dash-score: 18px;
    --dash-muted: var(--text-secondary);
    --dash-subtle: var(--text-muted);
    width: 100%;
    max-width: 1040px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: var(--shadow-elevated);
    text-align: left;
  }

  .hero-card-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    border-bottom: 1px solid var(--border);
    background: var(--bg-mockup-bar);
  }

  .hero-card-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .hero-card-title {
    font-size: 12px;
    color: var(--dash-subtle);
    margin-left: 8px;
    font-family: var(--font-mono);
