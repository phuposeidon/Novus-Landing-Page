---
import { getCollection } from "astro:content";
import { BLOG_URL } from "../config/site.ts";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---

<section class="blog-preview section" id="resources">
  <div class="container">
    <div class="blog-preview-header text-center">
      <span class="overline animate-on-scroll">Resources</span>
      <h2 class="display animate-on-scroll text-balance">
        AI search guides for Shopify
      </h2>
      <p class="body-lg animate-on-scroll blog-preview-dek">
        AEO playbooks on llms.txt, schema, crawler policy, and citation tracking.
      </p>
    </div>

    <ul class="blog-preview-grid">
      {posts.map((post) => (
        <li class="blog-preview-item">
          <article class="blog-preview-card card">
            <time datetime={post.data.pubDate.toISOString()} class="blog-preview-date">
              {post.data.pubDate.toLocaleDateString("en-US", {
                month: "short",
                day: "numeric",
                year: "numeric",
              })}
            </time>
            <h3 class="heading-3">
              <a
                href={`/blog/${post.id}/`}
                data-analytics-event="blog_card_click"
                data-analytics-location="home_resources"
                data-analytics-label={post.data.title}
              >{post.data.title}</a>
            </h3>
            <p class="body-sm blog-preview-excerpt">{post.data.description}</p>
            <span class="blog-preview-link" aria-hidden="true">Read guide →</span>
          </article>
        </li>
      ))}
    </ul>

    <div class="blog-preview-cta animate-on-scroll">
      <a href={BLOG_URL} class="btn btn-ghost">View all guides</a>
    </div>
  </div>
</section>

<style>
  .blog-preview-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 52ch;
    margin: 0 auto var(--space-9);
    align-items: center;
  }

  .blog-preview-dek {
    color: var(--text-secondary);
    margin: 0;
  }

  .blog-preview-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .blog-preview-item {
    min-width: 0;
  }

  .blog-preview-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    transition: border-color var(--duration-normal), box-shadow var(--duration-normal);
  }

  .blog-preview-card:hover {
    border-color: rgba(54, 244, 164, 0.22);
    box-shadow: 0 0 0 1px rgba(54, 244, 164, 0.06);
  }

  .blog-preview-card:hover .blog-preview-link {
    color: var(--accent);
  }

  .blog-preview-date {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .blog-preview-card h3 {
    margin: 0;
    line-height: 1.35;
  }

  .blog-preview-card h3 a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .blog-preview-card h3 a:hover {
    color: var(--accent);
  }

  .blog-preview-excerpt {
    flex: 1;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-preview-link {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  .blog-preview-cta {
    margin-top: var(--space-8);
    text-align: center;
  }

  @media (max-width: 900px) {
    .blog-preview-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
