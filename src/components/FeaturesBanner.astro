---
---

<section class="features-banner-section" id="features-banner">
  <div class="container">
    <div class="section-header animate-on-scroll">
      <span class="overline">AI Search Discoverability</span>
      <h2 class="display-lg text-balance">
        Continuous AI Visibility &amp; Rank Tracking Dashboard
      </h2>
      <p class="body-md section-sub text-balance">
        Monitor your store's citation share of voice across ChatGPT, Google Gemini, and Perplexity in real-time. Track longitudinal search prompts and audit brand citations vs competitors.
      </p>
    </div>

    <!-- Real High-Fidelity AI Rank Tracker Page Mockup -->
    <div class="banner-frame animate-on-scroll" aria-hidden="true">
      <div class="banner-window-header">
        <div class="window-dot" style="background: #ef4444;"></div>
        <div class="window-dot" style="background: #f59e0b;"></div>
        <div class="window-dot" style="background: var(--accent);"></div>
        <span class="window-title">Nexis CRO — AI Search Visibility &amp; Citations Tracker</span>
      </div>
      
      <!-- Rank Tracker Workspace layout -->
      <div class="tracker-dashboard">
        <!-- Top Score Section -->
        <div class="tracker-top-section">
          <div class="tracker-score-card">
            <p class="tracker-card-label">AI Visibility Score</p>
            <div class="tracker-score-flex">
              <!-- Score Circular Gauge -->
              <div class="gauge-wrapper">
                <svg class="gauge-svg" width="90" height="90" viewBox="0 0 36 36">
                  <path class="gauge-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="var(--border)" stroke-width="2.5" />
                  <path class="gauge-fill" stroke-dasharray="82, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" />
                </svg>
                <div class="gauge-text">
                  <span class="gauge-num mono">82</span>
                  <span class="gauge-denom">/100</span>

                </div>
              </div>
              <div class="score-status-info">
                <span class="status-indicator good">High visibility</span>
                <p class="status-text">Your store is highly recommended by AI engines. 16 of your 20 tracked prompts now actively cite your product links and brand aliases!</p>
                <button class="check-now-btn">Check now</button>
              </div>
            </div>
          </div>

          <!-- Quota info panel -->
          <div class="quota-panel">
            <div class="quota-header">
              <span class="quota-label">MONTHLY API QUOTA</span>
              <span class="quota-plan">Plan: GROWTH</span>
            </div>
            <div class="quota-progress-bar">
              <div class="quota-progress-fill" style="width: 32%;"></div>
            </div>
            <div class="quota-text">
              <span class="text-secondary"><strong class="text-white mono">384</strong> of 1,200 checks used</span>
              <span class="text-muted">Resets in 16 days</span>
            </div>
          </div>
        </div>

        <!-- Step 1 Card: Aliases -->
        <div class="tracker-card">
          <div class="card-header-bar">
            <p class="card-heading">Step 1 — Brand & competitor aliases <span class="tag-badge saved">Saved</span></p>
            <span class="text-muted text-xs">These names tell us what to look for when AI responds to your tracked prompts.</span>
          </div>
          
          <div class="form-group">
            <label class="input-label">Your brand aliases <span class="label-muted">(comma-separated)</span></label>
            <div class="mock-input-field">
              <span class="tag">your-store.myshopify.com</span>
              <span class="tag">Nexis Premium</span>
              <span class="tag">Nexis Brand</span>
            </div>
            <span class="field-hint">Your store name, domain, and any name variations customers or AI might use.</span>
          </div>

          <div class="form-group" style="margin-top: 14px;">
            <label class="input-label">Competitor aliases — optional <span class="label-muted">(comma-separated)</span></label>
            <div class="mock-input-field placeholder-field">
              <span>e.g. Semrush, Ahrefs, surfer-seo.com, Moz</span>
            </div>
            <span class="field-hint">We'll alert you when a competitor is mentioned instead of your store.</span>
          </div>
        </div>

        <!-- Step 2 Card: Tracked Prompts List -->
        <div class="tracker-card">
          <div class="card-header-bar">
            <p class="card-heading">Step 2 — Tracked prompts <span class="tag-badge prompt-count">(2/20 active)</span></p>
            <span class="text-muted text-xs">Questions your potential customers might ask ChatGPT, Gemini, or Claude. We query AI with each prompt and check if your store is recommended.</span>
          </div>

          <div class="prompts-list">
            <!-- Prompt 1 -->
            <div class="prompt-row-item">
              <div class="prompt-header-row">
                <span class="prompt-query font-serif-italic">"What's the best online store to buy running shoes from?"</span>
                <div class="prompt-actions">
                  <span class="prompt-action-btn">Disable</span>
                  <span class="prompt-action-btn delete">Delete</span>
                </div>
              </div>
              <div class="prompt-engines-grid">
                <div class="engine-badge positive">
                  <span class="engine-name">ChatGPT</span>
                  <span class="engine-status">CITED (74%)</span>
                </div>
                <div class="engine-badge negative">
                  <span class="engine-name">Google Gemini</span>
                  <span class="engine-status">NOT CITED (0%)</span>
                </div>
                <div class="engine-badge positive">
                  <span class="engine-name">Perplexity</span>
                  <span class="engine-status">CITED (58%)</span>
                </div>
              </div>
            </div>

            <!-- Prompt 2 -->
            <div class="prompt-row-item">
              <div class="prompt-header-row">
                <span class="prompt-query font-serif-italic">"Where can I buy highly rated ergonomic desk chairs?"</span>
                <div class="prompt-actions">
                  <span class="prompt-action-btn">Disable</span>
                  <span class="prompt-action-btn delete">Delete</span>
                </div>
              </div>
              <div class="prompt-engines-grid">
                <div class="engine-badge positive">
                  <span class="engine-name">ChatGPT</span>
                  <span class="engine-status">CITED (90%)</span>
                </div>
                <div class="engine-badge positive">
                  <span class="engine-name">Google Gemini</span>
                  <span class="engine-status">CITED (70%)</span>
                </div>
                <div class="engine-badge positive">
                  <span class="engine-name">Perplexity</span>
                  <span class="engine-status">CITED (85%)</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Metric highlights Bento Grid -->
    <div class="banner-highlights animate-on-scroll">
      <!-- Bento Card 1 -->
      <div class="highlight-card">
        <div class="card-icon-wrap">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
          </svg>
          <span class="card-tag">Real-Time Tracking</span>
        </div>
        <h3 class="highlight-title">AI Rank &amp; SOV Tracker</h3>
        <p class="highlight-desc">
          Continuous tracking across ChatGPT, Gemini, and Perplexity. Detect brand citations, position trends, and ranking velocity over time.
        </p>
        <div class="card-widget-chips">
          <span class="widget-chip good">ChatGPT: #1 Cited</span>
          <span class="widget-chip good">Perplexity: #1 Cited</span>
          <span class="widget-chip neutral">Gemini: 78% SOV</span>
        </div>
      </div>

      <!-- Bento Card 2 -->
      <div class="highlight-card highlight-card--featured">
        <div class="card-icon-wrap">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M12 6v6l4 2"></path>
          </svg>
          <span class="card-tag">Competitive Intel</span>
        </div>
        <h3 class="highlight-title">Citation Gap Analysis</h3>
        <p class="highlight-desc">
          Identify exact search queries where competitors are recommended over your store. Get automated schema &amp; copy fixes to bridge the gap.
        </p>
        <div class="card-widget-chips">
          <span class="widget-chip delta">+34% Brand Lift</span>
          <span class="widget-chip good">1-Click Content Fix</span>
        </div>
      </div>

      <!-- Bento Card 3 -->
      <div class="highlight-card">
        <div class="card-icon-wrap">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <span class="card-tag">Unified Search Lab</span>
        </div>
        <h3 class="highlight-title">Multi-Engine Search Lab</h3>
        <p class="highlight-desc">
          Unified workbench to query 4 AI models simultaneously. Inspect verbatim model responses, product grounding, and structured citations.
        </p>
        <div class="card-widget-chips">
          <span class="widget-chip good">4 Engines Parallel</span>
          <span class="widget-chip neutral">Auto JSON-LD</span>
        </div>
      </div>
    </div>
  </div>
</section>


<style>
  .features-banner-section {
    position: relative;
    padding: 100px 0;
    background: var(--bg-void);
    overflow: hidden;
    border-top: 1px solid var(--border);
  }

  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto var(--space-9);
  }

  .section-header h2 {
    color: var(--text-primary);
    margin-top: var(--space-2);
  }

  .section-sub {
    color: var(--text-secondary);
    margin-top: var(--space-4);
  }


  /* High-Fidelity Mockup Window */
  .banner-frame {
    --dash-label: 11px;
    --dash-badge: 10px;
    --dash-body: 13px;
    --dash-caption: 12px;
    --dash-heading: 15px;
    --dash-score: 28px;
    --dash-muted: var(--text-secondary);
    --dash-subtle: var(--text-muted);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: var(--shadow-elevated);
    margin-bottom: var(--space-9);
    text-align: left;
  }

  .banner-window-header {
    background: var(--bg-mockup-bar);
    padding: 12px 18px;
    display: flex;
    align-items: center;
    gap: 8px;
    border-bottom: 1px solid var(--border);
  }

  .window-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .window-title {
    font-size: 12px;
    font-family: var(--font-mono);
    color: var(--dash-subtle);
    margin-left: 12px;
    letter-spacing: 0.02em;
  }

  /* Tracker Dashboard Inner Layout */
  .tracker-dashboard {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .tracker-top-section {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-5);
  }

  .tracker-score-card, .quota-panel, .tracker-card {
    background: var(--bg-card-inner);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 22px;
  }

  .tracker-card-label {
    font-size: var(--dash-label);
    font-weight: 600;
    color: var(--dash-subtle);
    letter-spacing: 0.06em;
    margin-bottom: var(--space-3);
    text-transform: uppercase;
  }

  .tracker-score-flex {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  /* Score Gauge */
  .gauge-wrapper {
    position: relative;
    width: 90px;
    height: 90px;
    flex-shrink: 0;
  }

  .gauge-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
    display: block;
  }

  .gauge-fill {
    stroke-dasharray: 82, 100;
  }

  .gauge-text {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .gauge-text .gauge-num {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    font-size: 22px;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    margin: 0;
    white-space: nowrap;
  }

  .gauge-text .gauge-denom {
    position: absolute;
    left: 50%;
    top: calc(50% + 12px);
    transform: translateX(-50%);
    font-size: 9px;
    font-weight: 600;
    color: var(--dash-muted);
    line-height: 1;
    margin: 0;
    white-space: nowrap;
  }

  .score-status-info {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .status-indicator {
    font-size: var(--dash-badge);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-dim);
    padding: 4px 8px;
    border-radius: 4px;
    width: max-content;
    letter-spacing: 0.04em;
  }

  .status-text {
    font-size: var(--dash-body);
    color: var(--dash-muted);
    line-height: 1.55;
  }

  .check-now-btn {
    font-size: var(--dash-caption);
    font-weight: 600;
    background: var(--bg-glass);
    border: 1px solid var(--border);
    color: var(--text-primary);
    padding: 8px 14px;
    border-radius: 6px;
    cursor: pointer;
    width: max-content;
    margin-top: 4px;
    transition: background var(--duration-fast);
  }

  .check-now-btn:hover {
    background: var(--bg-glass-hover);
    border-color: var(--border-hover);
  }

  /* Quota info */
  .quota-panel {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .quota-header {
    display: flex;
    justify-content: space-between;
    width: 100%;
    gap: 12px;
  }

  .quota-label {
    font-size: var(--dash-label);
    font-weight: 600;
    color: var(--dash-subtle);
    letter-spacing: 0.06em;
  }

  .quota-plan {
    font-size: var(--dash-badge);
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-dim);
    padding: 3px 8px;
    border-radius: 4px;
  }

  .quota-progress-bar {
    width: 100%;
    height: 8px;
    background: var(--bg-glass-hover);
    border-radius: 4px;
    overflow: hidden;
    margin: 14px 0;
  }

  .quota-progress-fill {
    height: 100%;
    background: var(--accent);
    border-radius: 4px;
  }

  .quota-text {
    display: flex;
    justify-content: space-between;
    font-size: var(--dash-caption);
    color: var(--dash-muted);
    gap: 12px;
  }

  .quota-text .text-white {
    color: var(--text-primary);
    font-weight: 600;
  }

  .quota-text .text-muted {
    color: var(--dash-subtle);
  }

  /* Tracker Cards */
  .card-header-bar {
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 12px;
    margin-bottom: 16px;
  }

  .card-heading {
    font-size: var(--dash-heading);
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    line-height: 1.35;
  }

  .tag-badge {
    font-size: var(--dash-badge);
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .tag-badge.saved {
    background: rgba(16, 185, 129, 0.15);
    color: #10b981;
  }

  .tag-badge.prompt-count {
    background: rgba(59, 130, 246, 0.15);
    color: #3b82f6;
  }

  .text-xs {
    font-size: var(--dash-caption) !important;
    color: var(--dash-subtle) !important;
    line-height: 1.5 !important;
  }

  /* Mock Form controls */
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .input-label {
    font-size: var(--dash-body);
    font-weight: 600;
    color: var(--text-primary);
  }

  .label-muted {
    font-size: var(--dash-caption);
    font-weight: 400;
    color: var(--dash-subtle);
  }

  .mock-input-field {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 10px 14px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    min-height: 44px;
    align-items: center;
  }

  .mock-input-field .tag {
    background: var(--bg-glass-hover);
    border: 1px solid var(--border);
    font-size: var(--dash-caption);
    padding: 4px 10px;
    border-radius: 5px;
    color: var(--text-primary);
    font-family: var(--font-mono);
  }

  .placeholder-field {
    color: var(--dash-subtle);
    font-size: var(--dash-caption);
  }

  .field-hint {
    font-size: var(--dash-caption);
    color: var(--dash-subtle);
    margin-top: 2px;
    line-height: 1.45;
  }

  /* Prompts List */
  .prompts-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .prompt-row-item {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .prompt-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
    gap: 20px;
  }

  .prompt-query {
    font-size: var(--dash-body);
    font-weight: 500;
    color: var(--text-primary);
    line-height: 1.5;
  }

  .prompt-actions {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }

  .prompt-action-btn {
    font-size: var(--dash-caption);
    font-weight: 600;
    padding: 4px 8px;
    border-radius: 4px;
    background: var(--bg-glass);
    border: 1px solid var(--border);
    color: var(--dash-muted);
    cursor: pointer;
  }

  .prompt-action-btn.delete {
    color: #ef4444;
  }

  .prompt-engines-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }

  .engine-badge {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 14px;
    border-radius: 6px;
    font-size: var(--dash-caption);
    border: 1px solid transparent;
    gap: 8px;
  }

  .engine-badge.positive {
    background: var(--accent-dim);
    border-color: rgba(5, 150, 105, 0.2);
  }

  [data-theme="dark"] .engine-badge.positive {
    border-color: rgba(54, 244, 164, 0.2);
  }

  .engine-badge.positive .engine-name {
    color: var(--dash-muted);
    font-weight: 500;
  }

  .engine-badge.positive .engine-status {
    color: var(--accent);
    font-weight: 700;
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .engine-badge.negative {
    background: rgba(239, 68, 68, 0.08);
    border-color: rgba(239, 68, 68, 0.2);
  }

  .engine-badge.negative .engine-name {
    color: var(--dash-muted);
    font-weight: 500;
  }

  .engine-badge.negative .engine-status {
    color: #ef4444;
    font-weight: 700;
    font-family: var(--font-mono);
    font-size: 11px;
  }

  /* Highlights Bento Grid */
  .banner-highlights {
    display: grid !important;
    grid-template-columns: repeat(3, 1fr) !important;
    gap: var(--space-5);
  }

  .highlight-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: transform var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .highlight-card:hover {
    border-color: var(--border-hover);
    transform: translateY(-3px);
    box-shadow: var(--shadow-elevated);
  }

  .highlight-card--featured {
    border-color: rgba(5, 150, 105, 0.25);
    background: var(--bg-elevated);
  }

  [data-theme="dark"] .highlight-card--featured {
    border-color: rgba(54, 244, 164, 0.25);
  }

  .card-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--accent);
    margin-bottom: var(--space-2);
  }

  .card-tag {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 3px 8px;
    border-radius: var(--radius-pill);
    background: var(--bg-glass-hover);
    color: var(--text-muted);
    border: 1px solid var(--border);
  }

  .highlight-title {
    font-size: 17px;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .highlight-desc {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.55;
    margin: 0;
    flex: 1;
  }

  .card-widget-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
  }

  .widget-chip {
    font-size: 11px;
    font-weight: 600;
    font-family: var(--font-mono);
    padding: 3px 8px;
    border-radius: 4px;
  }

  .widget-chip.good {
    background: var(--accent-dim);
    color: var(--accent);
  }

  .widget-chip.neutral {
    background: var(--bg-glass-hover);
    color: var(--text-secondary);
    border: 1px solid var(--border);
  }

  .widget-chip.delta {
    background: rgba(16, 185, 129, 0.12);
    color: #10b981;
    font-weight: 700;
  }

  /* Responsiveness */
  @media (max-width: 960px) {
    .tracker-top-section {
      grid-template-columns: 1fr;
    }

    .banner-highlights {
      grid-template-columns: 1fr !important;
      gap: var(--space-4);
    }
  }

  @media (max-width: 880px) {
