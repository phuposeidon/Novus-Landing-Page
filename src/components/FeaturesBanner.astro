---
---

<section class="features-banner-section" id="features-banner">
  <div class="container">
    <div class="section-header animate-on-scroll">
      <span class="section-num mono">[ SECTION IV ]</span>
      <h2 class="display-lg text-balance">
        Continuous AI Visibility & <span class="serif-italic">Rank Tracking Dashboard</span>
      </h2>
      <p class="body-md section-sub text-balance">
        Monitor your store's citation share of voice across ChatGPT, Google Gemini, and Perplexity in real-time. Track longitudinal search prompts and audit brand citations vs competitors.
      </p>
    </div>

    <!-- Real High-Fidelity AI Rank Tracker Page Mockup -->
    <div class="banner-frame animate-on-scroll" aria-hidden="true">
      <div class="banner-window-header">
        <div class="window-dot" style="background: #ef4444;"></div>
        <div class="window-dot" style="background: #f59e0b;"></div>
        <div class="window-dot" style="background: #36f4a4;"></div>
        <span class="window-title">Nexis CRO — AI Search Visibility & Citations Tracker</span>
      </div>
      
      <!-- Rank Tracker Workspace layout -->
      <div class="tracker-dashboard">
        <!-- Top Score Section -->
        <div class="tracker-top-section">
          <div class="tracker-score-card">
            <p class="tracker-card-label">AI Visibility Score</p>
            <div class="tracker-score-flex">
              <!-- Score Circular Gauge -->
              <div class="gauge-wrapper">
                <svg class="gauge-svg" width="90" height="90" viewBox="0 0 36 36">
                  <path class="gauge-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="rgba(255,255,255,0.03)" stroke-width="2.5" />
                  <path class="gauge-fill" stroke-dasharray="82, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" />
                </svg>
                <div class="gauge-text">
                  <span class="gauge-num mono">82</span>
                  <span class="gauge-denom">/100</span>
                </div>
              </div>
              <div class="score-status-info">
                <span class="status-indicator good">High visibility</span>
                <p class="status-text">Your store is highly recommended by AI engines. 16 of your 20 tracked prompts now actively cite your product links and brand aliases!</p>
                <button class="check-now-btn">Check now</button>
              </div>
            </div>
          </div>

          <!-- Quota info panel -->
          <div class="quota-panel">
            <div class="quota-header">
              <span class="quota-label">MONTHLY API QUOTA</span>
              <span class="quota-plan">Plan: GROWTH</span>
            </div>
            <div class="quota-progress-bar">
              <div class="quota-progress-fill" style="width: 32%;"></div>
            </div>
            <div class="quota-text">
              <span class="text-secondary"><strong class="text-white mono">384</strong> of 1,200 checks used</span>
              <span class="text-muted">Resets in 16 days</span>
            </div>
          </div>
        </div>

        <!-- Step 1 Card: Aliases -->
        <div class="tracker-card">
          <div class="card-header-bar">
            <p class="card-heading">Step 1 — Brand & competitor aliases <span class="tag-badge saved">Saved</span></p>
            <span class="text-muted text-xs">These names tell us what to look for when AI responds to your tracked prompts.</span>
          </div>
          
          <div class="form-group">
            <label class="input-label">Your brand aliases <span class="label-muted">(comma-separated)</span></label>
            <div class="mock-input-field">
              <span class="tag">your-store.myshopify.com</span>
              <span class="tag">Nexis Premium</span>
              <span class="tag">Nexis Brand</span>
            </div>
            <span class="field-hint">Your store name, domain, and any name variations customers or AI might use.</span>
          </div>

          <div class="form-group" style="margin-top: 14px;">
            <label class="input-label">Competitor aliases — optional <span class="label-muted">(comma-separated)</span></label>
            <div class="mock-input-field placeholder-field">
              <span>e.g. Semrush, Ahrefs, surfer-seo.com, Moz</span>
            </div>
            <span class="field-hint">We'll alert you when a competitor is mentioned instead of your store.</span>
          </div>
        </div>

        <!-- Step 2 Card: Tracked Prompts List -->
        <div class="tracker-card">
          <div class="card-header-bar">
            <p class="card-heading">Step 2 — Tracked prompts <span class="tag-badge prompt-count">(2/20 active)</span></p>
            <span class="text-muted text-xs">Questions your potential customers might ask ChatGPT, Gemini, or Claude. We query AI with each prompt and check if your store is recommended.</span>
          </div>

          <div class="prompts-list">
            <!-- Prompt 1 -->
            <div class="prompt-row-item">
              <div class="prompt-header-row">
                <span class="prompt-query font-serif-italic">"What's the best online store to buy running shoes from?"</span>
                <div class="prompt-actions">
                  <span class="prompt-action-btn">Disable</span>
                  <span class="prompt-action-btn delete">Delete</span>
                </div>
              </div>
              <div class="prompt-engines-grid">
                <div class="engine-badge positive">
                  <span class="engine-name">ChatGPT</span>
                  <span class="engine-status">CITED (74%)</span>
                </div>
                <div class="engine-badge negative">
                  <span class="engine-name">Google Gemini</span>
                  <span class="engine-status">NOT CITED (0%)</span>
                </div>
                <div class="engine-badge positive">
                  <span class="engine-name">Perplexity</span>
                  <span class="engine-status">CITED (58%)</span>
                </div>
              </div>
            </div>

            <!-- Prompt 2 -->
            <div class="prompt-row-item">
              <div class="prompt-header-row">
                <span class="prompt-query font-serif-italic">"Where can I buy highly rated ergonomic desk chairs?"</span>
                <div class="prompt-actions">
                  <span class="prompt-action-btn">Disable</span>
                  <span class="prompt-action-btn delete">Delete</span>
                </div>
              </div>
              <div class="prompt-engines-grid">
                <div class="engine-badge positive">
                  <span class="engine-name">ChatGPT</span>
                  <span class="engine-status">CITED (90%)</span>
                </div>
                <div class="engine-badge positive">
                  <span class="engine-name">Google Gemini</span>
                  <span class="engine-status">CITED (70%)</span>
                </div>
                <div class="engine-badge positive">
                  <span class="engine-name">Perplexity</span>
                  <span class="engine-status">CITED (85%)</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Metric highlights grid -->
    <div class="banner-highlights grid animate-on-scroll">
      <div class="highlight-card">
        <div class="card-metric mono">01</div>
        <h3 class="heading-sm">AI Rank Tracker</h3>
        <p class="body-sm">
          Run automated or on-demand queries across multiple LLM providers. Detect exactly where your brand is cited and track your visibility position over time.
        </p>
      </div>

      <div class="highlight-card">
        <div class="card-metric mono">02</div>
        <h3 class="heading-sm">Citation Gap Analysis</h3>
        <p class="body-sm">
          Identify keywords where competitors are recommended by AI engines instead of you. Get instant recommendations on what content to inject to bridge the gap.
        </p>
      </div>

      <div class="highlight-card">
        <div class="card-metric mono">03</div>
        <h3 class="heading-sm">Multi-Engine Search</h3>
        <p class="body-sm">
          A unified hub to analyze search results from ChatGPT, Claude, Gemini, and Perplexity in parallel. Uncover recommendations and structural citations with ease.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .features-banner-section {
    position: relative;
    padding: 100px 0;
    background: #000;
    overflow: hidden;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto var(--space-9);
  }

  .section-num {
    display: block;
    font-size: 12px;
    color: var(--accent);
    letter-spacing: 0.15em;
    margin-bottom: var(--space-4);
  }

  .serif-italic {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    color: var(--text-primary);
  }

  .section-sub {
    color: var(--text-secondary);
    margin-top: var(--space-4);
  }

  /* High-Fidelity Mockup Window */
  .banner-frame {
    --dash-label: 11px;
    --dash-badge: 10px;
    --dash-body: 13px;
    --dash-caption: 12px;
    --dash-heading: 15px;
    --dash-score: 28px;
    --dash-muted: #c4c4cc;
    --dash-subtle: #a8a8b2;
    background: #080808;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 24px 60px -12px rgba(0, 0, 0, 0.6);
    margin-bottom: var(--space-9);
    text-align: left;
  }

  .banner-window-header {
    background: #0d0d0d;
    padding: 12px 18px;
    display: flex;
    align-items: center;
    gap: 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .window-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .window-title {
    font-size: 12px;
    font-family: 'JetBrains Mono', monospace;
    color: var(--dash-subtle);
    margin-left: 12px;
    letter-spacing: 0.02em;
  }

  /* Tracker Dashboard Inner Layout */
  .tracker-dashboard {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .tracker-top-section {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-5);
  }

  .tracker-score-card, .quota-panel, .tracker-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 22px;
  }

  .tracker-card-label {
    font-size: var(--dash-label);
    font-weight: 600;
    color: var(--dash-subtle);
    letter-spacing: 0.06em;
    margin-bottom: var(--space-3);
    text-transform: uppercase;
  }

  .tracker-score-flex {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  /* Score Gauge */
  .gauge-wrapper {
    position: relative;
    width: 90px;
    height: 90px;
    flex-shrink: 0;
  }

  .gauge-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
    display: block;
  }

  .gauge-fill {
    stroke-dasharray: 82, 100;
  }

  .gauge-text {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .gauge-text .gauge-num {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    font-size: 22px;
    font-weight: 700;
    color: #ffffff;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    margin: 0;
    white-space: nowrap;
  }

  .gauge-text .gauge-denom {
    position: absolute;
    left: 50%;
    top: calc(50% + 12px);
    transform: translateX(-50%);
    font-size: 9px;
    font-weight: 600;
    color: var(--dash-muted);
    line-height: 1;
    margin: 0;
    white-space: nowrap;
  }

  .score-status-info {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .status-indicator {
    font-size: var(--dash-badge);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--accent);
    background: rgba(54, 244, 164, 0.12);
    padding: 4px 8px;
    border-radius: 4px;
    width: max-content;
    letter-spacing: 0.04em;
  }

  .status-text {
    font-size: var(--dash-body);
    color: var(--dash-muted);
    line-height: 1.55;
  }

  .check-now-btn {
    font-size: var(--dash-caption);
    font-weight: 600;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-primary);
    padding: 8px 14px;
    border-radius: 6px;
    cursor: pointer;
    width: max-content;
    margin-top: 4px;
  }

  /* Quota info */
  .quota-panel {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .quota-header {
    display: flex;
    justify-content: space-between;
    width: 100%;
    gap: 12px;
  }

  .quota-label {
    font-size: var(--dash-label);
    font-weight: 600;
    color: var(--dash-subtle);
    letter-spacing: 0.06em;
  }

  .quota-plan {
    font-size: var(--dash-badge);
    font-weight: 600;
    color: var(--accent);
    background: rgba(54, 244, 164, 0.12);
    padding: 3px 8px;
    border-radius: 4px;
  }

  .quota-progress-bar {
    width: 100%;
    height: 8px;
    background: rgba(255, 255, 255, 0.06);
    border-radius: 4px;
    overflow: hidden;
    margin: 14px 0;
  }

  .quota-progress-fill {
    height: 100%;
    background: var(--accent);
    border-radius: 4px;
  }

  .quota-text {
    display: flex;
    justify-content: space-between;
    font-size: var(--dash-caption);
    color: var(--dash-muted);
    gap: 12px;
  }

  .quota-text .text-white {
    color: var(--text-primary);
    font-weight: 600;
  }

  .quota-text .text-muted {
    color: var(--dash-subtle);
  }

  /* Tracker Cards */
  .card-header-bar {
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding-bottom: 12px;
    margin-bottom: 16px;
  }

  .card-heading {
    font-size: var(--dash-heading);
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    line-height: 1.35;
  }

  .tag-badge {
    font-size: var(--dash-badge);
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .tag-badge.saved {
    background: rgba(16, 185, 129, 0.18);
    color: #6ee7b7;
  }

  .tag-badge.prompt-count {
    background: rgba(59, 130, 246, 0.18);
    color: #93c5fd;
  }

  .text-xs {
    font-size: var(--dash-caption) !important;
    color: var(--dash-subtle) !important;
    line-height: 1.5 !important;
  }

  /* Mock Form controls */
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .input-label {
    font-size: var(--dash-body);
    font-weight: 600;
    color: var(--text-primary);
  }

  .label-muted {
    font-size: var(--dash-caption);
    font-weight: 400;
    color: var(--dash-subtle);
  }

  .mock-input-field {
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 10px 14px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    min-height: 44px;
    align-items: center;
  }

  .mock-input-field .tag {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    font-size: var(--dash-caption);
    padding: 4px 10px;
    border-radius: 5px;
    color: var(--text-primary);
    font-family: var(--font-mono);
  }

  .placeholder-field {
    color: var(--dash-subtle);
    font-size: var(--dash-caption);
  }

  .field-hint {
    font-size: var(--dash-caption);
    color: var(--dash-subtle);
    margin-top: 2px;
    line-height: 1.45;
  }

  /* Prompts List */
  .prompts-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .prompt-row-item {
    background: rgba(255, 255, 255, 0.01);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .prompt-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
    gap: 20px;
  }

  .prompt-query {
    font-size: var(--dash-body);
    font-weight: 500;
    color: var(--text-primary);
    line-height: 1.5;
  }

  .font-serif-italic {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
  }

  .prompt-actions {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }

  .prompt-action-btn {
    font-size: var(--dash-caption);
    font-weight: 600;
    padding: 4px 8px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--dash-muted);
    cursor: pointer;
  }

  .prompt-action-btn.delete {
    color: #f87171;
  }

  .prompt-engines-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }

  .engine-badge {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 14px;
    border-radius: 6px;
    font-size: var(--dash-caption);
    border: 1px solid transparent;
    gap: 8px;
  }

  .engine-badge.positive {
    background: rgba(54, 244, 164, 0.03);
    border-color: rgba(54, 244, 164, 0.12);
  }

  .engine-badge.positive .engine-name {
    color: var(--dash-muted);
    font-weight: 500;
  }

  .engine-badge.positive .engine-status {
    color: var(--accent);
    font-weight: 700;
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .engine-badge.negative {
    background: rgba(239, 68, 68, 0.03);
    border-color: rgba(239, 68, 68, 0.12);
  }

  .engine-badge.negative .engine-name {
    color: var(--dash-muted);
    font-weight: 500;
  }

  .engine-badge.negative .engine-status {
    color: #f87171;
    font-weight: 700;
    font-family: var(--font-mono);
    font-size: 11px;
  }

  /* Highlights Grid */
  .banner-highlights {
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .highlight-card {
    background: rgba(255, 255, 255, 0.01);
    border: 1px solid rgba(255, 255, 255, 0.04);
    padding: var(--space-8);
    border-radius: 8px;
    transition: border-color var(--duration-fast), background-color var(--duration-fast);
  }

  .highlight-card:hover {
    border-color: rgba(54, 244, 164, 0.15);
    background: rgba(254, 244, 164, 0.005);
  }

  .card-metric {
    font-size: 13px;
    color: var(--accent);
    margin-bottom: var(--space-3);
    font-weight: 500;
  }

  .highlight-card h3 {
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .highlight-card p {
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* Responsiveness */
  @media (max-width: 960px) {
    .tracker-top-section {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 880px) {
    .banner-highlights {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    
    .features-banner-section {
      padding: 60px 0;
    }
  }
</style>