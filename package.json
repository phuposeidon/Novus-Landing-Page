{
  "name": "nexis-landing",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/generate-agent-skills-index.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-llms.mjs && astro build && node scripts/patch-routes.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "dns-aid": "node scripts/setup-dns-aid.mjs",
    "flow:sync": "python3 scripts/sync-flow.py --allow-drift",
    "flow:install": "node scripts/install-cursor-skills.mjs",
    "seo:install": "bash seo-suite/install.sh",
    "seo:install:full": "bash seo-suite/install.sh --full",
    "seo:doctor": "bash seo-suite/doctor.sh",
    "seo:run": "node scripts/seo-run.mjs",
    "seo:pava": "python3 scripts/seo-pava-loop.py --mode=audit",
    "seo:pava:act": "python3 scripts/seo-pava-loop.py --mode=act",
    "seo:test": "bash seo-suite/tests/run-tests.sh",
    "seo:uninstall": "bash seo-suite/install.sh --uninstall",
    "deploy": "npm run build && wrangler pages deploy dist/ --project-name novus-landing --commit-dirty=true"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "astro": "^5.18.2",
    "resend": "^6.12.4"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "ws": "^8.21.0",
    "undici": "^7.28.1",
    "sharp": "^0.35.0"
  }
}
